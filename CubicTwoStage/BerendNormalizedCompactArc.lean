import CubicTwoStage.BerendCoordDense
import CubicTwoStage.BerendPhaseArc

open Set Filter Topology
open scoped Pointwise

set_option maxHeartbeats 1200000

namespace CubicTwoStage
namespace BerendNormalizedCompactArc

open BerendPlanarArc BerendPhaseArc

abbrev Circle1 := AddCircle (1 : ℝ)
abbrev Torus2 := Circle1 × Circle1

noncomputable def quot2 : ℝ × ℝ →+ Torus2 :=
  (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ))).prodMap
    (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ)))

@[simp] theorem quot2_apply (z : ℝ × ℝ) :
    quot2 z = ((z.1 : Circle1), (z.2 : Circle1)) := rfl

theorem surjective_quot2 : Function.Surjective quot2 := by
  rintro ⟨a, b⟩
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective (AddSubgroup.zmultiples (1 : ℝ)) a
  obtain ⟨b, rfl⟩ := QuotientAddGroup.mk'_surjective (AddSubgroup.zmultiples (1 : ℝ)) b
  exact ⟨(a, b), rfl⟩

theorem continuous_quot2 : Continuous quot2 := by
  exact (AddCircle.continuous_mk' 1).prodMap (AddCircle.continuous_mk' 1)

theorem isOpenMap_quot2 : IsOpenMap quot2 := by
  exact QuotientAddGroup.isOpenMap_coe.prodMap QuotientAddGroup.isOpenMap_coe

/-- The compact group topologically generated by positive (equivalently integer) multiples. -/
noncomputable def cyclicClosure (x : Torus2) : AddSubgroup Torus2 :=
  (AddSubgroup.zmultiples x).topologicalClosure

/-- The full preimage of `cyclicClosure x` in the real plane. -/
noncomputable def liftClosure (x : Torus2) : AddSubgroup (ℝ × ℝ) :=
  (cyclicClosure x).comap quot2

theorem cyclicClosure_coe (x : Torus2) :
    (cyclicClosure x : Set Torus2) = closure (AddSubgroup.zmultiples x : Set Torus2) := by
  exact AddSubgroup.topologicalClosure_coe

theorem isClosed_cyclicClosure (x : Torus2) : IsClosed (cyclicClosure x : Set Torus2) := by
  rw [cyclicClosure_coe]
  exact isClosed_closure

theorem isClosed_liftClosure (x : Torus2) : IsClosed (liftClosure x : Set (ℝ × ℝ)) := by
  exact (isClosed_cyclicClosure x).preimage continuous_quot2

theorem infinite_cyclicClosure {x : Torus2} (hx : ¬ IsOfFinAddOrder x) :
    (cyclicClosure x : Set Torus2).Infinite := by
  have hinf : (AddSubgroup.zmultiples x : Set Torus2).Infinite := infinite_zmultiples.mpr hx
  rw [cyclicClosure_coe]
  exact hinf.mono subset_closure

/-- A non-torsion point has non-discrete full lift. -/
theorem not_isolatedZero_liftClosure {x : Torus2} (hx : ¬ IsOfFinAddOrder x) :
    ¬ BerendCoordDense.IsolatedZero (liftClosure x) := by
  intro hiso
  obtain ⟨ε, hε, hsmall⟩ := hiso
  let U : Set Torus2 := quot2 '' Metric.ball 0 ε
  have hUopen : IsOpen U := isOpenMap_quot2 _ Metric.isOpen_ball
  have hinter : U ∩ (cyclicClosure x : Set Torus2) = {0} := by
    apply Set.eq_singleton_iff_unique_mem.mpr
    constructor
    · refine ⟨?_, (cyclicClosure x).zero_mem⟩
      exact ⟨0, by simpa [Metric.mem_ball, dist_zero_right] using hε, map_zero quot2⟩
    · intro y hy
      obtain ⟨z, hz, rfl⟩ := hy.1
      have hzG : quot2 z ∈ cyclicClosure x := hy.2
      have hzD : z ∈ liftClosure x := hzG
      have hzn : ‖z‖ < ε := by simpa [Metric.mem_ball, dist_zero_right] using hz
      have hz0 : z = 0 := hsmall z hzD hzn
      simp [hz0]
  have hU0 : (0 : Torus2) ∈ U := by
    exact ⟨0, by simpa [Metric.mem_ball, dist_zero_right] using hε, map_zero quot2⟩
  have hzeroOpen : IsOpen ({0} : Set (cyclicClosure x)) := by
    rw [isOpen_induced_iff]
    refine ⟨U, hUopen, ?_⟩
    ext y
    constructor
    · intro hy
      have hy' : (y : Torus2) ∈ U ∩ (cyclicClosure x : Set Torus2) := ⟨hy, y.2⟩
      rw [hinter] at hy'
      apply Subtype.ext
      exact hy'
    · intro hy
      have hy0 : y = 0 := by exact hy
      subst y
      exact hU0
  letI : DiscreteTopology (cyclicClosure x) :=
    discreteTopology_iff_isOpen_singleton_zero.mpr hzeroOpen
  have hcompact : IsCompact (cyclicClosure x : Set Torus2) :=
    (isClosed_cyclicClosure x).isCompact
  letI : CompactSpace (cyclicClosure x) := isCompact_iff_compactSpace.mp hcompact
  have hfin : (Set.univ : Set (cyclicClosure x)).Finite := isCompact_univ.finite_of_discrete
  have hfin' : (cyclicClosure x : Set Torus2).Finite := by
    simpa using hfin.image (Subtype.val : cyclicClosure x → Torus2)
  exact (infinite_cyclicClosure hx).not_finite hfin'

/-- Every standard integer vector belongs to the full lift. -/
theorem standard_mem_liftClosure (x : Torus2) (z : ℤ × ℤ) :
    (((z.1 : ℝ), (z.2 : ℝ)) : ℝ × ℝ) ∈ liftClosure x := by
  change quot2 (((z.1 : ℝ), (z.2 : ℝ))) ∈ cyclicClosure x
  have hz : quot2 (((z.1 : ℝ), (z.2 : ℝ))) = 0 := by
    apply Prod.ext
    · exact (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr ⟨z.1, by simp⟩
    · exact (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr ⟨z.2, by simp⟩
  rw [hz]
  exact (cyclicClosure x).zero_mem

/-- The line produced for a non-torsion point lies over the compact cyclic closure. -/
theorem exists_real_line_liftClosure {x : Torus2} (hx : ¬ IsOfFinAddOrder x) :
    ∃ u : ℝ × ℝ, u ≠ 0 ∧ ∀ t : ℝ, t • u ∈ liftClosure x := by
  exact BerendCoordDense.exists_line_of_not_isolatedZero
    (isClosed_liftClosure x) (not_isolatedZero_liftClosure hx)

/-- Embedded integer vectors in the real plane. -/
noncomputable def realOfInt2 (l : ℤ × ℤ) : ℝ × ℝ := ((l.1 : ℝ), (l.2 : ℝ))

@[simp] theorem realOfInt2_fst (l : ℤ × ℤ) : (realOfInt2 l).1 = l.1 := rfl
@[simp] theorem realOfInt2_snd (l : ℤ × ℤ) : (realOfInt2 l).2 = l.2 := rfl

theorem linearMap_prod_apply_eq (k : ℝ × ℝ →ₗ[ℝ] ℝ) (z : ℝ × ℝ) :
    k z = z.1 • k (1, 0) + z.2 • k (0, 1) := by
  have hz : z = z.1 • (1, 0) + z.2 • (0, 1) := by
    apply Prod.ext <;> simp
  conv_lhs => rw [hz]
  rw [map_add, map_smul, map_smul]

/-- An integer-valued functional on a closed lift must kill every real line in that lift. -/
theorem annihilates_line_of_integer_values {D : AddSubgroup (ℝ × ℝ)}
    {k : ℝ × ℝ →ₗ[ℝ] ℝ} {u : ℝ × ℝ}
    (hline : ∀ t : ℝ, t • u ∈ D) (hkint : ∀ h ∈ D, ∃ m : ℤ, k h = m) :
    k u = 0 := by
  obtain ⟨m, hm⟩ := hkint u (by simpa using hline 1)
  by_contra hkne
  have hmne : (m : ℝ) ≠ 0 := by
    intro h
    apply hkne
    rw [hm, h]
  let t : ℝ := (2 * (m : ℝ))⁻¹
  obtain ⟨n, hn⟩ := hkint (t • u) (hline t)
  have hn' : (n : ℝ) = 1 / 2 := by
    rw [map_smul, hm, smul_eq_mul] at hn
    calc (n : ℝ) = t * (m : ℝ) := hn.symm
      _ = 1 / 2 := by dsimp [t]; field_simp
  have hn2 : 2 * n = 1 := by
    have hreal : (2 : ℝ) * (n : ℝ) = 1 := by linarith
    exact_mod_cast hreal
  omega

/-- A nonzero integral direction whose whole real line lies over the compact cyclic group. -/
theorem exists_integer_direction {x : Torus2} (hx : ¬ IsOfFinAddOrder x) :
    ∃ l : ℤ × ℤ, l ≠ 0 ∧ 0 ≤ l.1 ∧ (l.1 = 0 → IsOfFinAddOrder x.1) ∧
      ∀ t : ℝ, quot2 (t • realOfInt2 l) ∈ cyclicClosure x := by
  obtain ⟨u, hu0, hul⟩ := exists_real_line_liftClosure hx
  by_cases htop : liftClosure x = ⊤
  · refine ⟨(1, 0), by simp, by simp, by simp, ?_⟩
    intro t
    have hmem : t • realOfInt2 (1, 0) ∈ liftClosure x := by rw [htop]; trivial
    exact hmem
  · obtain ⟨k, hk0, hkint⟩ :=
      BerendCoordDense.exists_integral_functional_of_isClosed (ℝ × ℝ)
        (isClosed_liftClosure x) htop
    obtain ⟨p, hp⟩ := hkint (1, 0) (by
      simpa using standard_mem_liftClosure x (1, 0))
    obtain ⟨q, hq⟩ := hkint (0, 1) (by
      simpa using standard_mem_liftClosure x (0, 1))
    have hkform (z : ℝ × ℝ) : k z = (p : ℝ) * z.1 + (q : ℝ) * z.2 := by
      rw [linearMap_prod_apply_eq, hp, hq]
      simp only [smul_eq_mul]
      ring
    have hku : k u = 0 := annihilates_line_of_integer_values hul hkint
    have hkueq : (p : ℝ) * u.1 + (q : ℝ) * u.2 = 0 := by
      rw [hkform] at hku
      exact hku
    let l : ℤ × ℤ := (-q, p)
    have hl0 : l ≠ 0 := by
      intro hl
      have hp0 : p = 0 := by exact congrArg Prod.snd hl
      have hq0 : q = 0 := by
        have h := congrArg Prod.fst hl
        exact neg_eq_zero.mp h
      subst p
      subst q
      apply hk0
      apply LinearMap.ext
      intro z
      rw [hkform]
      simp
    have hlform : realOfInt2 l = ((-q : ℝ), (p : ℝ)) := by
      simp [l, realOfInt2]
    obtain ⟨c, hc⟩ : ∃ c : ℝ, realOfInt2 l = c • u := by
      by_cases hp0 : p = 0
      · subst p
        have hq0 : q ≠ 0 := by
          intro hq0
          apply hk0
          apply LinearMap.ext
          intro z
          rw [hkform, hq0]
          simp
        have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast hq0
        have hu2 : u.2 = 0 := by
          simp only [Int.cast_zero, zero_mul, zero_add] at hkueq
          exact (mul_eq_zero.mp hkueq).resolve_left hqR
        have hu1 : u.1 ≠ 0 := by
          intro hu1
          apply hu0
          exact Prod.ext hu1 hu2
        refine ⟨(-q : ℝ) / u.1, ?_⟩
        rw [hlform]
        apply Prod.ext
        · simp only [Prod.smul_fst, smul_eq_mul]
          field_simp
        · simp [hu2]
      · have hpR : (p : ℝ) ≠ 0 := by exact_mod_cast hp0
        have hu2 : u.2 ≠ 0 := by
          intro hu2
          have hu1 : u.1 = 0 := by
            rw [hu2, mul_zero, add_zero] at hkueq
            exact (mul_eq_zero.mp hkueq).resolve_left hpR
          apply hu0
          exact Prod.ext hu1 hu2
        refine ⟨(p : ℝ) / u.2, ?_⟩
        rw [hlform]
        apply Prod.ext
        · simp only [Prod.smul_fst, smul_eq_mul]
          field_simp
          nlinarith [hkueq]
        · simp only [Prod.smul_snd, smul_eq_mul]
          field_simp
    have hlD : ∀ t : ℝ, t • realOfInt2 l ∈ liftClosure x := by
      intro t
      rw [hc, smul_smul]
      exact hul (t * c)
    have hvert : l.1 = 0 → IsOfFinAddOrder x.1 := by
      intro hlfirst0
      have hq0 : q = 0 := by
        have h := hlfirst0
        change -q = 0 at h
        exact neg_eq_zero.mp h
      have hp0 : p ≠ 0 := by
        intro hp0
        apply hl0
        apply Prod.ext <;> simp [l, hp0, hq0]
      obtain ⟨z, hz⟩ := surjective_quot2 x
      have hzG : quot2 z ∈ cyclicClosure x := by
        rw [hz]
        exact AddSubgroup.le_topologicalClosure (AddSubgroup.zmultiples x)
          (AddSubgroup.mem_zmultiples x)
      obtain ⟨r, hr⟩ := hkint z hzG
      have hpr : (p : ℝ) * z.1 = (r : ℝ) := by
        rw [hkform, hq0] at hr
        simpa using hr
      have hx1 : x.1 = (z.1 : Circle1) := by
        have h := congrArg Prod.fst hz
        exact h.symm
      rw [isOfFinAddOrder_iff_nsmul_eq_zero]
      refine ⟨p.natAbs, Int.natAbs_pos.mpr hp0, ?_⟩
      rw [hx1, ← AddCircle.coe_nsmul]
      by_cases hpnonneg : 0 ≤ p
      · have hpa : ((p.natAbs : ℕ) : ℤ) = p := Int.natAbs_of_nonneg hpnonneg
        have hpaR : ((p.natAbs : ℕ) : ℝ) = (p : ℝ) :=
          congrArg (fun n : ℤ => (n : ℝ)) hpa
        have hval : ((p.natAbs : ℕ) : ℝ) * z.1 = (r : ℝ) := by rw [hpaR]; exact hpr
        apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
        refine ⟨r, ?_⟩
        simpa only [nsmul_eq_mul, zsmul_eq_mul, mul_one] using hval.symm
      · have hpneg : 0 ≤ -p := by omega
        have hpa : (((-p).natAbs : ℕ) : ℤ) = -p := Int.natAbs_of_nonneg hpneg
        have hpaR : ((p.natAbs : ℕ) : ℝ) = -(p : ℝ) := by
          calc
            ((p.natAbs : ℕ) : ℝ) = (((p.natAbs : ℕ) : ℤ) : ℝ) := (Int.cast_natCast p.natAbs).symm
            _ = ((((-p).natAbs : ℕ) : ℤ) : ℝ) := by rw [Int.natAbs_neg]
            _ = ((-p : ℤ) : ℝ) := congrArg (fun n : ℤ => (n : ℝ)) hpa
            _ = -(p : ℝ) := by simp
        have hval : ((p.natAbs : ℕ) : ℝ) * z.1 = (-r : ℝ) := by
          rw [hpaR]
          push_cast
          linarith
        apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
        refine ⟨-r, ?_⟩
        simpa only [nsmul_eq_mul, zsmul_eq_mul, mul_one, Int.cast_neg] using hval.symm
    by_cases hlfirst : 0 ≤ l.1
    · exact ⟨l, hl0, hlfirst, hvert, fun t => hlD t⟩
    · refine ⟨-l, by simpa using hl0, ?_, ?_, ?_⟩
      · have hlt : l.1 < 0 := Int.lt_of_not_ge hlfirst
        simp only [Prod.fst_neg]
        omega
      · intro hneg
        apply hvert
        exact neg_eq_zero.mp hneg
      · intro t
        have h := hlD (-t)
        have heq : t • realOfInt2 (-l) = -t • realOfInt2 l := by
          apply Prod.ext <;> simp [realOfInt2]
        rw [heq]
        exact h

/-- Irrationality in the ordinary sense gives non-torsion on the unit additive circle. -/
theorem not_isOfFinAddOrder_coe_of_irrational {α : ℝ} (hα : Irrational α) :
    ¬ IsOfFinAddOrder (α : Circle1) := by
  intro hfin
  obtain ⟨n, hn, hz⟩ := isOfFinAddOrder_iff_nsmul_eq_zero.mp hfin
  rw [← AddCircle.coe_nsmul] at hz
  obtain ⟨m, hm⟩ := (AddCircle.coe_eq_zero_iff (1 : ℝ)).mp hz
  have hn0 : (n : ℝ) ≠ 0 := by positivity
  have hval : α = (m : ℝ) / (n : ℝ) := by
    simp only [nsmul_eq_mul, zsmul_eq_mul, mul_one] at hm
    field_simp
    linarith
  exact hα ⟨(m : ℚ) / (n : ℚ), by push_cast; rw [hval]⟩

/-- If the first coordinate is non-torsion, the compact-group direction can be chosen with
strictly positive radial coefficient. -/
theorem exists_positive_integer_direction {α δ : ℝ}
    (hα : ¬ IsOfFinAddOrder (α : Circle1)) (x : Torus2) (hx : x.1 = (α : Circle1))
    (hnontors : ¬ IsOfFinAddOrder x) :
    ∃ l : ℤ × ℤ, l ≠ 0 ∧ 0 < l.1 ∧
      ∀ t : ℝ, quot2 (t • realOfInt2 l) ∈ cyclicClosure x := by
  obtain ⟨l, hl, hl0, hvert, hline⟩ := exists_integer_direction hnontors
  refine ⟨l, hl, ?_, hline⟩
  by_cases hzero : l.1 = 0
  · exact absurd (hx ▸ hvert hzero) hα
  · omega

/-- The normalized lattice-phase point in Berend's Lemma 4.5. -/
noncomputable def normalizedPoint (α δ : ℝ) : Torus2 := quot2 (α, δ)

/-- Corrected B3 implies non-torsion of the *normalized* pair.  This does not assert
phase density; it is exactly the log/phase exponent dichotomy used in Berend's proof. -/
theorem not_isOfFinAddOrder_normalizedPoint {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hB3 : MultIndepPair c d) (hlogc : Real.log ‖c‖ ≠ 0) {α β γ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d) :
    ¬ IsOfFinAddOrder (normalizedPoint α (γ - α * β)) := by
  intro hfin
  obtain ⟨n, hn, hz⟩ := isOfFinAddOrder_iff_nsmul_eq_zero.mp hfin
  rw [normalizedPoint, ← map_nsmul] at hz
  have hz1 := congrArg Prod.fst hz
  have hz2 := congrArg Prod.snd hz
  have hz1' : (((n : ℝ) * α : ℝ) : Circle1) = 0 := by
    simpa [quot2, nsmul_eq_mul] using hz1
  have hz2' : (((n : ℝ) * (γ - α * β) : ℝ) : Circle1) = 0 := by
    simpa [quot2, nsmul_eq_mul] using hz2
  obtain ⟨a, ha⟩ := (AddCircle.coe_eq_zero_iff (1 : ℝ)).mp hz1'
  obtain ⟨b, hb⟩ := (AddCircle.coe_eq_zero_iff (1 : ℝ)).mp hz2'
  simp only [nsmul_eq_mul, zsmul_eq_mul, mul_one] at ha hb
  have ha' : (a : ℝ) = (n : ℝ) * α := ha
  have hb' : (b : ℝ) = (n : ℝ) * (γ - α * β) := hb
  have hlogs : (a : ℝ) * Real.log ‖c‖ = (n : ℝ) * Real.log ‖d‖ := by
    rw [ha', hα]
    field_simp [hlogc]
  have hlog : latticeLog c d (-a) (n : ℤ) = 0 := by
    simp only [latticeLog, Int.cast_neg, Int.cast_natCast]
    linarith
  have hphase : latticePhase c d (-a) (n : ℤ) = b := by
    simp only [latticePhase, Int.cast_neg, Int.cast_natCast]
    rw [← hβ, ← hγ]
    calc
      -(a : ℝ) * β + (n : ℝ) * γ =
          (n : ℝ) * (γ - α * β) + ((n : ℝ) * α - (a : ℝ)) * β := by ring
      _ = (b : ℝ) := by rw [← hb', ← ha']; ring
  obtain ⟨ha0, hn0⟩ := hB3 (-a) (n : ℤ)
    (pair_zpow_mul_eq_one_of_log_phase hc hd hlog hphase)
  have : (n : ℤ) = 0 := hn0
  have : n = 0 := by exact_mod_cast this
  omega

/-- Membership in the compact cyclic closure is witnessed by a sequence of nonnegative
multiples, not merely integer multiples. -/
theorem exists_nsmul_tendsto_of_mem_cyclicClosure {x y : Torus2}
    (hy : y ∈ cyclicClosure x) :
    ∃ n : ℕ → ℕ, Tendsto (fun m => n m • x) atTop (𝓝 y) := by
  have hyZ : y ∈ closure (Set.range fun n : ℤ => n • x) := by
    rw [← AddSubgroup.coe_zmultiples, ← cyclicClosure_coe]
    exact hy
  have hyN : y ∈ closure (Set.range fun n : ℕ => n • x) := by
    rwa [← closure_range_zsmul_eq_nsmul x]
  obtain ⟨z, hz, hzt⟩ := mem_closure_iff_seq_limit.mp hyN
  choose n hn using fun m => hz m
  exact ⟨n, by simpa only [hn] using hzt⟩

/-- The complex exponential of `2πi` times a real number, as a continuous function on the
additive circle. -/
theorem coe_toCircle_eq_phaseArc (x : ℝ) :
    ((AddCircle.toCircle (x : Circle1) : Circle) : ℂ) = phaseArc x 1 := by
  rw [AddCircle.toCircle_apply_mk, Circle.coe_exp]
  unfold phaseArc
  simp only [div_one]
  congr 1
  push_cast
  ring

@[simp] theorem normalizedPoint_nsmul (n : ℕ) (α δ : ℝ) :
    n • normalizedPoint α δ = quot2 (((n : ℝ) * α, (n : ℝ) * δ)) := by
  rw [normalizedPoint, ← map_nsmul]
  congr 1
  apply Prod.ext <;> simp [nsmul_eq_mul]

@[simp] theorem coe_equivIco_nsmul (n : ℕ) (α : ℝ) :
    (((AddCircle.equivIco (1 : ℝ) 0) (n • (α : Circle1)) :
      Set.Ico (0 : ℝ) (0 + (1 : ℝ))) : ℝ) =
      Int.fract ((n : ℝ) * α) := by
  have hquot : (((n : ℝ) * α : ℝ) : Circle1) = n • (α : Circle1) := by
    rw [← AddCircle.coe_nsmul]
    congr 1
    simp [nsmul_eq_mul]
  rw [← hquot]
  rw [AddCircle.coe_equivIco_mk_apply]
  simp only [div_one, mul_one]

/-- Sequence convergence in the circle gives convergence of the corresponding fractional
parts of the first coordinate at an interior target. -/
theorem tendsto_fract_of_tendsto_normalized {α δ a b : ℝ} {n : ℕ → ℕ}
    (hseq : Tendsto (fun m => n m • normalizedPoint α δ) atTop (𝓝 (quot2 (a, b))))
    (ha : a ∈ Set.Ioo (0 : ℝ) 1) :
    Tendsto (fun m => Int.fract ((n m : ℝ) * α)) atTop (𝓝 a) := by
  have hseq1 : Tendsto (fun m => (((n m : ℝ) * α : ℝ) : Circle1)) atTop (𝓝 (a : Circle1)) := by
    have h := (continuous_fst.tendsto (quot2 (a, b))).comp hseq
    simpa only [normalizedPoint_nsmul, quot2_apply, Function.comp_def, Prod.fst] using h
  have ha0 : (a : Circle1) ≠ (0 : ℝ) := by
    intro h
    have heq : a = 0 := (AddCircle.coe_eq_coe_iff_of_mem_Ico (p := (1 : ℝ)) (a := (0 : ℝ))
      (x := a) (y := (0 : ℝ))
      (by simpa only [zero_add] using Set.Ioo_subset_Ico_self ha) (by simp)).mp h
    exact ha.1.ne' heq
  have hc := (AddCircle.continuousAt_equivIco (p := (1 : ℝ)) (a := (0 : ℝ)) ha0).tendsto
  have hconv := (continuous_subtype_val.tendsto ((AddCircle.equivIco 1 0) (a : Circle1))).comp
    (hc.comp hseq1)
  simpa [coe_equivIco_nsmul, AddCircle.coe_equivIco_mk_apply, AddCircle.equivIco_coe_eq
    (show a ∈ Set.Ico 0 (0 + 1) from by simpa only [zero_add] using Set.Ioo_subset_Ico_self ha),
    Int.fract_eq_self.mpr ⟨ha.1.le, ha.2⟩, Function.comp_def] using hconv

/-- Sequence convergence in the circle gives convergence of the `2πi`-exponential of the
second coordinate, without choosing a real representative modulo an integer. -/
theorem tendsto_phaseArc_of_tendsto_normalized {α δ a b : ℝ} {n : ℕ → ℕ}
    (hseq : Tendsto (fun m => n m • normalizedPoint α δ) atTop (𝓝 (quot2 (a, b)))) :
    Tendsto (fun m => phaseArc ((n m : ℝ) * δ) 1) atTop (𝓝 (phaseArc b 1)) := by
  have hcont : Continuous (fun z : Circle1 => ((AddCircle.toCircle z : Circle) : ℂ)) :=
    continuous_subtype_val.comp AddCircle.continuous_toCircle
  have hseq2 : Tendsto (fun m => (((n m : ℝ) * δ : ℝ) : Circle1)) atTop (𝓝 (b : Circle1)) := by
    have h := (continuous_snd.tendsto (quot2 (a, b))).comp hseq
    simpa only [normalizedPoint_nsmul, quot2_apply, Function.comp_def, Prod.snd] using h
  have hconv := (hcont.tendsto (b : Circle1)).comp hseq2
  simpa only [coe_toCircle_eq_phaseArc, Function.comp_def] using hconv

/-- Berend's normalized sequence in the complex-coordinate case. -/
noncomputable def normalizedSample (c d : ℂ) (α : ℝ) (j : ℕ) : ℂ :=
  c ^ (-⌊(j : ℝ) * α⌋) * d ^ (j : ℤ)

/-- Exact exponential form of `normalizedSample`, equivalently Berend's (4.9) for one
complex coordinate. -/
theorem normalizedSample_eq_exp {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hlogc : Real.log ‖c‖ ≠ 0) {α β γ δ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d) (hδ : δ = γ - α * β) (j : ℕ) :
    normalizedSample c d α j = Complex.exp
      (((Real.log ‖c‖ * Int.fract ((j : ℝ) * α) : ℝ) : ℂ) +
        (((Int.fract ((j : ℝ) * δ) + Int.fract ((j : ℝ) * α) * β : ℝ)) : ℂ) *
          (2 * (Real.pi : ℂ) * Complex.I)) := by
  have hlogd : Real.log ‖d‖ = α * Real.log ‖c‖ := by
    rw [hα]
    field_simp [hlogc]
  have hfα : ((⌊((j : ℝ) * α)⌋ : ℤ) : ℝ) = (j : ℝ) * α - Int.fract ((j : ℝ) * α) := by
    have h := Int.fract_add_floor ((j : ℝ) * α)
    linarith
  have hfδ : ((⌊((j : ℝ) * δ)⌋ : ℤ) : ℝ) = (j : ℝ) * δ - Int.fract ((j : ℝ) * δ) := by
    have h := Int.fract_add_floor ((j : ℝ) * δ)
    linarith
  have hfδC : ((⌊((j : ℝ) * δ)⌋ : ℤ) : ℂ) =
      (((j : ℝ) * δ - Int.fract ((j : ℝ) * δ) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_intCast, hfδ]
  rw [normalizedSample, zpow_mul_zpow_eq_exp hc hd]
  rw [Complex.exp_eq_exp_iff_exists_int]
  refine ⟨⌊((j : ℝ) * δ)⌋, ?_⟩
  simp only [latticeLog, latticePhase, Int.cast_neg, Int.cast_natCast, neg_mul]
  rw [hfα, hlogd, ← hβ, ← hγ, hfδC]
  push_cast
  have hγeq : γ = δ + α * β := by rw [hδ]; ring
  rw [hγeq]
  push_cast
  ring

@[simp] theorem phaseArc_fract (x : ℝ) : phaseArc (Int.fract x) 1 = phaseArc x 1 := by
  calc
    phaseArc (Int.fract x) 1 = ((AddCircle.toCircle ((Int.fract x : ℝ) : Circle1) : Circle) : ℂ) :=
      (coe_toCircle_eq_phaseArc _).symm
    _ = ((AddCircle.toCircle (x : Circle1) : Circle) : ℂ) := by rw [AddCircle.coe_fract]
    _ = phaseArc x 1 := coe_toCircle_eq_phaseArc _

theorem phaseArc_add_frequency (x y : ℝ) :
    phaseArc (x + y) 1 = phaseArc x 1 * phaseArc y 1 := by
  unfold phaseArc
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- Factorized form of the normalized sample, suitable for limits on the circle. -/
theorem normalizedSample_eq_factors {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hlogc : Real.log ‖c‖ ≠ 0) {α β γ δ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d) (hδ : δ = γ - α * β) (j : ℕ) :
    normalizedSample c d α j =
      ((‖c‖ ^ Int.fract ((j : ℝ) * α) : ℝ) : ℂ) *
        (phaseArc (Int.fract ((j : ℝ) * δ)) 1 *
          phaseArc (Int.fract ((j : ℝ) * α) * β) 1) := by
  rw [normalizedSample_eq_exp hc hd hlogc hα hβ hγ hδ, Complex.exp_add]
  have hrad : Complex.exp ((Real.log ‖c‖ * Int.fract ((j : ℝ) * α) : ℝ) : ℂ) =
      ((‖c‖ ^ Int.fract ((j : ℝ) * α) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_exp, Real.rpow_def_of_pos (norm_pos_iff.mpr hc)]
  rw [hrad, ← phaseArc_add_frequency]
  simp only [phaseArc, one_mul]

/-- Berend's normalized spiral/ellipse in one complex coordinate. -/
noncomputable def normalizedSpiral (c : ℂ) (β : ℝ) (l : ℤ × ℤ) (t : ℝ) : ℂ :=
  ((‖c‖ ^ ((l.1 : ℝ) * t) : ℝ) : ℂ) *
    (phaseArc ((l.2 : ℝ) * t) 1 * phaseArc ((l.1 : ℝ) * t * β) 1)

/-- The full arc through `w₀`. -/
noncomputable def normalizedArc (c : ℂ) (β : ℝ) (l : ℤ × ℤ) (w₀ : ℂ) (t : ℝ) : ℂ :=
  normalizedSpiral c β l t * w₀

/-- At an interior radial target, the normalized spiral is a limit of normalized iterates. -/
theorem exists_tendsto_normalizedSpiral {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hlogc : Real.log ‖c‖ ≠ 0) {α β γ δ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d) (hδ : δ = γ - α * β)
    {l : ℤ × ℤ} {t : ℝ}
    (hline : quot2 (t • realOfInt2 l) ∈ cyclicClosure (normalizedPoint α δ))
    (ht : ((l.1 : ℝ) * t) ∈ Set.Ioo (0 : ℝ) 1) :
    ∃ n : ℕ → ℕ, Tendsto (fun m => normalizedSample c d α (n m)) atTop
      (𝓝 (normalizedSpiral c β l t)) := by
  have hreplace : t • realOfInt2 l = (((l.1 : ℝ) * t, (l.2 : ℝ) * t)) := by
    apply Prod.ext <;> simp [realOfInt2] <;> ring
  rw [hreplace] at hline
  obtain ⟨n, hseq⟩ := exists_nsmul_tendsto_of_mem_cyclicClosure hline
  have hA := tendsto_fract_of_tendsto_normalized hseq ht
  have hB0 := tendsto_phaseArc_of_tendsto_normalized hseq
  have hB : Tendsto (fun m => phaseArc (Int.fract ((n m : ℝ) * δ)) 1) atTop
      (𝓝 (phaseArc ((l.2 : ℝ) * t) 1)) := by
    simpa only [phaseArc_fract] using hB0
  have hcr : Continuous (fun x : ℝ => phaseArc (x * β) 1) := by
    unfold phaseArc
    fun_prop
  have hC : Tendsto (fun m => phaseArc (Int.fract ((n m : ℝ) * α) * β) 1) atTop
      (𝓝 (phaseArc (((l.1 : ℝ) * t) * β) 1)) := by
    have h := (hcr.tendsto ((l.1 : ℝ) * t)).comp hA
    simpa only [Function.comp_def] using h
  have hrcont : Continuous (fun x : ℝ => ((‖c‖ ^ x : ℝ) : ℂ)) := by
    simp_rw [Real.rpow_def_of_pos (norm_pos_iff.mpr hc)]
    fun_prop
  have hR : Tendsto (fun m => ((‖c‖ ^ Int.fract ((n m : ℝ) * α) : ℝ) : ℂ)) atTop
      (𝓝 (((‖c‖ ^ ((l.1 : ℝ) * t) : ℝ) : ℂ))) := by
    have h := (hrcont.tendsto ((l.1 : ℝ) * t)).comp hA
    simpa only [Function.comp_def] using h
  refine ⟨n, ?_⟩
  have hlim := hR.mul (hB.mul hC)
  simpa only [normalizedSample_eq_factors hc hd hlogc hα hβ hγ hδ, normalizedSpiral] using hlim

/-- Closedness turns the preceding subsequence into actual arc placement in the invariant
complex lift. -/
theorem normalizedSpiral_mem_of_isClosed {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hlogc : Real.log ‖c‖ ≠ 0) {α β γ δ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d) (hδ : δ = γ - α * β)
    {E : Set ℂ} (hE : IsClosed E) (hsample : ∀ j, normalizedSample c d α j ∈ E)
    {l : ℤ × ℤ} {t : ℝ}
    (hline : quot2 (t • realOfInt2 l) ∈ cyclicClosure (normalizedPoint α δ))
    (ht : ((l.1 : ℝ) * t) ∈ Set.Ioo (0 : ℝ) 1) :
    normalizedSpiral c β l t ∈ E := by
  obtain ⟨n, hlim⟩ := exists_tendsto_normalizedSpiral hc hd hlogc hα hβ hγ hδ hline ht
  exact hE.mem_of_tendsto hlim (Eventually.of_forall fun m => hsample (n m))

/-- Basepoint form of `normalizedSpiral_mem_of_isClosed`. -/
theorem normalizedArc_mem_of_isClosed {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hlogc : Real.log ‖c‖ ≠ 0) {α β γ δ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d) (hδ : δ = γ - α * β)
    {E : Set ℂ} (hE : IsClosed E) (w₀ : ℂ)
    (hsample : ∀ j, normalizedSample c d α j * w₀ ∈ E)
    {l : ℤ × ℤ} {t : ℝ}
    (hline : quot2 (t • realOfInt2 l) ∈ cyclicClosure (normalizedPoint α δ))
    (ht : ((l.1 : ℝ) * t) ∈ Set.Ioo (0 : ℝ) 1) :
    normalizedArc c β l w₀ t ∈ E := by
  obtain ⟨n, hlim⟩ := exists_tendsto_normalizedSpiral hc hd hlogc hα hβ hγ hδ hline ht
  have hlim' := hlim.mul_const w₀
  exact hE.mem_of_tendsto hlim' (Eventually.of_forall fun m => hsample (n m))

/-- Berend Lemma 4.5 in one complex coordinate, for irrational logarithmic rate ratio:
there is an honest positive-length normalized arc in every closed set containing the
normalized backward-orbit samples. -/
theorem exists_normalizedArc_of_irrational {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hB3 : MultIndepPair c d) (hlogc : Real.log ‖c‖ ≠ 0) {α β γ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d) (hαirr : Irrational α)
    {E : Set ℂ} (hE : IsClosed E) (w₀ : ℂ)
    (hsample : ∀ j, normalizedSample c d α j * w₀ ∈ E) :
    ∃ (l : ℤ × ℤ) (t' : ℝ), l ≠ 0 ∧ 0 < l.1 ∧ 0 < t' ∧
      ∀ t ∈ Set.Icc (0 : ℝ) t', normalizedArc c β l w₀ t ∈ E := by
  let δ : ℝ := γ - α * β
  have hnontors : ¬ IsOfFinAddOrder (normalizedPoint α δ) :=
    not_isOfFinAddOrder_normalizedPoint hc hd hB3 hlogc hα hβ hγ
  have hfirst : ¬ IsOfFinAddOrder (α : Circle1) :=
    not_isOfFinAddOrder_coe_of_irrational hαirr
  obtain ⟨l, hl, hl0, hline⟩ :=
    exists_positive_integer_direction (δ := δ) hfirst (normalizedPoint α δ) rfl hnontors
  have hl0R : (0 : ℝ) < (l.1 : ℝ) := by exact_mod_cast hl0
  let t' : ℝ := 1 / ((l.1 : ℝ) + 1)
  have ht' : 0 < t' := by dsimp [t']; positivity
  refine ⟨l, t', hl, hl0, ht', ?_⟩
  intro t ht
  by_cases ht0 : t = 0
  · subst t
    have hzero : normalizedArc c β l w₀ 0 = w₀ := by
      simp [normalizedArc, normalizedSpiral, phaseArc]
    rw [hzero]
    simpa [normalizedSample] using hsample 0
  · have htpos : 0 < t := lt_of_le_of_ne ht.1 (Ne.symm ht0)
    have hinterior : ((l.1 : ℝ) * t) ∈ Set.Ioo (0 : ℝ) 1 := by
      constructor
      · exact mul_pos hl0R htpos
      · have hle : (l.1 : ℝ) * t ≤ (l.1 : ℝ) * t' :=
          mul_le_mul_of_nonneg_left ht.2 hl0R.le
        have hratio : ((l.1 : ℝ) + 1)⁻¹ * (l.1 : ℝ) < 1 := by
          have hden : 0 < (l.1 : ℝ) + 1 := by linarith
          rw [inv_mul_eq_div, div_lt_one hden]
          linarith
        have ht'eval : (l.1 : ℝ) * t' = ((l.1 : ℝ) + 1)⁻¹ * (l.1 : ℝ) := by
          dsimp [t']; ring
        exact lt_of_le_of_lt (ht'eval ▸ hle) hratio
    exact normalizedArc_mem_of_isClosed hc hd hlogc hα hβ hγ rfl hE w₀ hsample
      (hline t) hinterior

/-- Rational reals are torsion modulo one. -/
theorem isOfFinAddOrder_coe_rat (r : ℚ) : IsOfFinAddOrder ((r : ℝ) : Circle1) := by
  rw [isOfFinAddOrder_iff_nsmul_eq_zero]
  refine ⟨r.den, r.den_pos, ?_⟩
  rw [← AddCircle.coe_nsmul]
  apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
  refine ⟨r.num, ?_⟩
  have hval : (r.den : ℝ) * (r : ℝ) = (r.num : ℝ) := by
    rw [Rat.cast_def]
    field_simp [r.den_nz]
  simpa only [nsmul_eq_mul, zsmul_eq_mul, mul_one] using hval.symm

/-- Clearing a rational denominator preserves the non-torsion supplied by the normalized pair. -/
theorem not_isOfFinAddOrder_mul_of_normalized {α δ : ℝ} {q : ℕ} {A : ℤ}
    (hq : 0 < q) (hA : (q : ℝ) * α = (A : ℝ))
    (hnontors : ¬ IsOfFinAddOrder (normalizedPoint α δ)) :
    ¬ IsOfFinAddOrder (((q : ℝ) * δ : ℝ) : Circle1) := by
  intro hfin
  obtain ⟨N, hN, hz⟩ := isOfFinAddOrder_iff_nsmul_eq_zero.mp hfin
  apply hnontors
  rw [isOfFinAddOrder_iff_nsmul_eq_zero]
  refine ⟨N * q, Nat.mul_pos hN hq, ?_⟩
  rw [normalizedPoint_nsmul]
  apply Prod.ext
  · have hreal : (((N * q : ℕ) : ℝ) * α : ℝ) = (((N : ℤ) * A : ℤ) : ℝ) := by
      calc
        ((N * q : ℕ) : ℝ) * α = (N : ℝ) * ((q : ℝ) * α) := by push_cast; ring
        _ = (N : ℝ) * (A : ℝ) := by rw [hA]
        _ = (((N : ℤ) * A : ℤ) : ℝ) := by push_cast; ring
    simp only [quot2_apply, Prod.smul_fst, nsmul_eq_mul]
    rw [hreal]
    exact (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr ⟨(N : ℤ) * A, by simp⟩
  · rw [← AddCircle.coe_nsmul] at hz
    have hreal : (((N * q : ℕ) : ℝ) * δ : ℝ) = (N : ℝ) * ((q : ℝ) * δ) := by
      push_cast
      ring
    simp only [quot2_apply, Prod.smul_snd, nsmul_eq_mul]
    rw [hreal]
    change (((N : ℝ) * ((q : ℝ) * δ) : ℝ) : Circle1) = (0 : Circle1)
    simpa only [nsmul_eq_mul] using hz

/-- Samples indexed by multiples of a denominator reduce to powers of a unit complex phase. -/
theorem normalizedSample_denom_mul {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hlogc : Real.log ‖c‖ ≠ 0) {α β γ δ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d) (hδ : δ = γ - α * β)
    {q : ℕ} {A : ℤ} (hA : (q : ℝ) * α = (A : ℝ)) (n : ℕ) :
    normalizedSample c d α (q * n) = phaseArc ((q : ℝ) * δ) 1 ^ n := by
  have hfa : Int.fract (((q * n : ℕ) : ℝ) * α) = 0 := by
    rw [Int.fract_eq_zero_iff]
    refine ⟨(n : ℤ) * A, ?_⟩
    calc
      ((((n : ℤ) * A : ℤ) : ℝ)) = (n : ℝ) * ((q : ℝ) * α) := by rw [hA]; push_cast; ring
      _ = ((q * n : ℕ) : ℝ) * α := by push_cast; ring
  rw [normalizedSample_eq_factors hc hd hlogc hα hβ hγ hδ, hfa]
  simp only [Real.rpow_zero, Complex.ofReal_one, zero_mul, one_mul]
  have hphase0 : phaseArc (0 : ℝ) 1 = 1 := by simp [phaseArc]
  rw [hphase0, mul_one, phaseArc_fract]
  have harg : ((q * n : ℕ) : ℝ) * δ = (n : ℝ) * ((q : ℝ) * δ) := by
    push_cast
    ring
  rw [harg, phaseArc, phaseArc, ← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

/-- Berend Lemma 4.5 in one complex coordinate when the log-rate ratio is rational:
clearing its denominator gives the full elliptical branch. -/
theorem normalizedArc_mem_of_rational {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hB3 : MultIndepPair c d) (hlogc : Real.log ‖c‖ ≠ 0) {α β γ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d)
    {q : ℕ} {A : ℤ} (hq : 0 < q) (hA : (q : ℝ) * α = (A : ℝ))
    {E : Set ℂ} (hE : IsClosed E) (w₀ : ℂ)
    (hsample : ∀ j, normalizedSample c d α j * w₀ ∈ E) (t : ℝ) :
    normalizedArc c β (0, (q : ℤ)) w₀ t ∈ E := by
  let δ : ℝ := γ - α * β
  let ξ : ℝ := (q : ℝ) * δ
  have hnontors : ¬ IsOfFinAddOrder (normalizedPoint α δ) :=
    not_isOfFinAddOrder_normalizedPoint hc hd hB3 hlogc hα hβ hγ
  have hξfin : ¬ IsOfFinAddOrder (ξ : Circle1) := by
    exact not_isOfFinAddOrder_mul_of_normalized hq hA hnontors
  have hξ : Irrational ξ := by
    rintro ⟨r, hr⟩
    apply hξfin
    rw [← hr]
    exact isOfFinAddOrder_coe_rat r
  have hξ0 : ξ ≠ 0 := by
    intro hz
    apply hξ
    exact ⟨(0 : ℚ), by simpa using hz.symm⟩
  have hδ0 : δ ≠ 0 := by
    intro hzero
    apply hξ0
    dsimp [ξ]
    rw [hzero]
    ring
  have hsimp : normalizedArc c β (0, (q : ℤ)) w₀ t =
      phaseArc (((q : ℤ) : ℝ) * t) 1 * w₀ := by
    simp [normalizedArc, normalizedSpiral, phaseArc]
  have harg : (((q : ℤ) : ℝ) * t) = ξ * (t / δ) := by
    dsimp [ξ]
    push_cast
    field_simp [hδ0]
  have hval : phaseArc ξ (t / δ) = phaseArc (ξ * (t / δ)) 1 := by
    unfold phaseArc
    congr 1
    push_cast
    ring
  rw [hsimp, harg, ← hval]
  have hclosure := range_phaseArc_subset_closure_range_pow hξ
    (show phaseArc ξ (t / δ) ∈ Set.range (phaseArc ξ) from ⟨t / δ, rfl⟩)
  obtain ⟨z, hz, hzt⟩ := mem_closure_iff_seq_limit.mp hclosure
  choose n hn using fun m => hz m
  have heq (m : ℕ) : phaseArc ξ 1 ^ n m = z m := by
    rw [← phaseArc_nat]
    exact hn m
  have hlim : Tendsto (fun m => phaseArc ξ 1 ^ n m * w₀) atTop
      (𝓝 (phaseArc ξ (t / δ) * w₀)) := by
    simpa only [heq] using hzt.mul_const w₀
  apply hE.mem_of_tendsto hlim
  filter_upwards [] with m
  rw [← normalizedSample_denom_mul hc hd hlogc hα hβ hγ rfl hA (n m)]
  exact hsample (q * n m)

/-- A single normalized-arc existence theorem for the rational-rate branch. -/
theorem exists_normalizedArc_of_rational {c d : ℂ} (hc : c ≠ 0) (hd : d ≠ 0)
    (hB3 : MultIndepPair c d) (hlogc : Real.log ‖c‖ ≠ 0) {α β γ : ℝ}
    (hα : α = Real.log ‖d‖ / Real.log ‖c‖)
    (hβ : β = phaseOf c) (hγ : γ = phaseOf d)
    {q : ℕ} {A : ℤ} (hq : 0 < q) (hA : (q : ℝ) * α = (A : ℝ))
    {E : Set ℂ} (hE : IsClosed E) (w₀ : ℂ)
    (hsample : ∀ j, normalizedSample c d α j * w₀ ∈ E) :
    ∃ (l : ℤ × ℤ) (t' : ℝ), l ≠ 0 ∧ 0 < t' ∧
      ∀ t ∈ Set.Icc (0 : ℝ) t', normalizedArc c β l w₀ t ∈ E := by
  have hq' : q ≠ 0 := Nat.ne_of_gt hq
  refine ⟨(0, (q : ℤ)), 1, ?_, zero_lt_one, ?_⟩
  · simp [hq']
  · intro t _ht
    exact normalizedArc_mem_of_rational hc hd hB3 hlogc hα hβ hγ hq hA hE w₀ hsample t

end BerendNormalizedCompactArc
end CubicTwoStage
