import CubicTwoStage.BerendPhaseArc
import CubicTwoStage.BerendTangentNet

open Set Filter Topology
open scoped Pointwise

namespace CubicTwoStage
namespace BerendInterfaceAudit

open BerendPlanarArc BerendPhaseArc BerendTangentNet

/-- Real powers through a positive real multiplier are just positive real powers. -/
theorem scaleFlow_ofReal_pos {x : ℝ} (hx : 0 < x) (t : ℝ) :
    scaleFlow (x : ℂ) t = ((x ^ t : ℝ) : ℂ) := by
  rw [scaleFlow_eq_polar]
  · simp [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hx,
      Complex.arg_ofReal_of_nonneg hx.le]
  · exact_mod_cast (ne_of_gt hx)

/-- Every point of the semigroup generated by two positive real multipliers is
itself (the coercion of) a positive real. -/
theorem exists_pos_of_mem_multSemi_ofReal {c d : ℝ} (hc : 0 < c) (hd : 0 < d)
    {s : ℂ} (hs : s ∈ multSemi (c : ℂ) (d : ℂ)) :
    ∃ q : ℝ, 0 < q ∧ s = (q : ℂ) := by
  obtain ⟨p, rfl⟩ := hs
  refine ⟨c ^ p.1 * d ^ (p.2 : ℤ), mul_pos (zpow_pos hc _) (zpow_pos hd _), ?_⟩
  rw [Complex.ofReal_mul, Complex.ofReal_zpow, Complex.ofReal_zpow]

/-- A positive-real multiplier semigroup with dense radii contains every positive
real `scaleFlow` arc in its closure.  No phase-density or circle hypothesis is
used. -/
theorem scaleFlow_mem_closure_multSemi_ofReal {c d z : ℝ}
    (hc : 0 < c) (hd : 0 < d) (hd1 : d ≠ 1)
    (hirr : Irrational (Real.log c / Real.log d)) (hz : 0 < z) (t : ℝ) :
    scaleFlow (z : ℂ) t ∈ closure (multSemi (c : ℂ) (d : ℂ)) := by
  have hc0 : (c : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hc)
  have hd0 : (d : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hd)
  have hdn : ‖(d : ℂ)‖ ≠ 1 := by
    simpa [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hd] using hd1
  have hirr' : Irrational (Real.log ‖(c : ℂ)‖ / Real.log ‖(d : ℂ)‖) := by
    simpa [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hc, abs_of_pos hd] using hirr
  rw [scaleFlow_ofReal_pos hz, Metric.mem_closure_iff]
  intro ε hε
  obtain ⟨s, hs, happrox⟩ := dense_radius_of_multSemi hc0 hd0 hdn hirr'
    (z ^ t) (Real.rpow_pos_of_pos hz t) ε hε
  obtain ⟨q, hq, rfl⟩ := exists_pos_of_mem_multSemi_ofReal hc hd hs
  refine ⟨(q : ℂ), hs, ?_⟩
  rw [Complex.isometry_ofReal.dist_eq, Real.dist_eq]
  simpa [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hq, abs_sub_comm] using happrox

/-- The repository's `(e, e^{√2})` example has a nontrivial radial arc in the
semigroup closure, despite its proved failure to contain the unit circle. -/
theorem exp_arc_mem_closure_multSemi (t : ℝ) :
    scaleFlow ((Real.exp 1 : ℝ) : ℂ) t ∈
      closure (multSemi ((Real.exp 1 : ℝ) : ℂ)
        ((Real.exp (Real.sqrt 2) : ℝ) : ℂ)) := by
  apply scaleFlow_mem_closure_multSemi_ofReal (Real.exp_pos _) (Real.exp_pos _)
  · exact ne_of_gt (Real.one_lt_exp_iff.mpr
      (Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 2)))
  · simpa [one_div] using irrational_sqrt_two.inv
  · exact Real.exp_pos _

/-- In `arcThrough` form, this is an actual compact arc on every interval. -/
theorem exp_arcThrough_mem_closure_multSemi (t : ℝ) :
    cplxOf (arcThrough 1 (((Real.exp 1 : ℝ) : ℂ)) t) ∈
      closure (multSemi ((Real.exp 1 : ℝ) : ℂ)
        ((Real.exp (Real.sqrt 2) : ℝ) : ℂ)) := by
  rw [arcThrough, BerendBlockLastMile.cplxOf_ofCplx, one_mul]
  exact exp_arc_mem_closure_multSemi t

/-- The radial arc in the example is injective, hence genuinely nonconstant. -/
theorem exp_scaleFlow_injective :
    Function.Injective (scaleFlow ((Real.exp 1 : ℝ) : ℂ)) := by
  apply scaleFlow_injective_of_norm_ne_one
  · exact_mod_cast (Real.exp_pos 1).ne'
  · rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos 1)]
    exact ne_of_gt (Real.one_lt_exp_iff.mpr zero_lt_one)

/-- In particular, the example does not satisfy the named `PhaseDenseSemi`
residual predicate. -/
theorem not_phaseDenseSemi_exp :
    ¬ PhaseDenseSemi ((Real.exp 1 : ℝ) : ℂ)
      ((Real.exp (Real.sqrt 2) : ℝ) : ℂ) := by
  intro hphase
  exact not_unitCircle_subset_closure_multSemi
    (unitCircle_subset_closure_of_phaseDenseSemi hphase)

/-- One and the same semigroup has an injective `scaleFlow` arc in its closure but
fails the circle/phase-density conclusion. -/
theorem exp_arc_despite_no_circle :
    Function.Injective (scaleFlow ((Real.exp 1 : ℝ) : ℂ)) ∧
      (∀ t : ℝ, scaleFlow ((Real.exp 1 : ℝ) : ℂ) t ∈
        closure (multSemi ((Real.exp 1 : ℝ) : ℂ)
          ((Real.exp (Real.sqrt 2) : ℝ) : ℂ))) ∧
      ¬ unitCircle ⊆ closure (multSemi ((Real.exp 1 : ℝ) : ℂ)
        ((Real.exp (Real.sqrt 2) : ℝ) : ℂ)) :=
  ⟨exp_scaleFlow_injective, exp_arc_mem_closure_multSemi,
    not_unitCircle_subset_closure_multSemi⟩

/-- The actual arc obligation therefore cannot be equivalent to
`PhaseDenseSemi`: the former holds and the latter fails here. -/
theorem exp_arc_despite_not_phaseDenseSemi :
    Function.Injective (scaleFlow ((Real.exp 1 : ℝ) : ℂ)) ∧
      (∀ t : ℝ, scaleFlow ((Real.exp 1 : ℝ) : ℂ) t ∈
        closure (multSemi ((Real.exp 1 : ℝ) : ℂ)
          ((Real.exp (Real.sqrt 2) : ℝ) : ℂ))) ∧
      ¬ PhaseDenseSemi ((Real.exp 1 : ℝ) : ℂ)
        ((Real.exp (Real.sqrt 2) : ℝ) : ℂ) :=
  ⟨exp_scaleFlow_injective, exp_arc_mem_closure_multSemi, not_phaseDenseSemi_exp⟩

