/-
# The rank-two expansion step (`BEREND_PROOF_PLAN.md` §C.5, dimension one)

Stage C.4/C.5 of the plan has to upgrade "`0` is a non-isolated point of the
closed invariant set `E`" to "`E - E` contains a neighbourhood of `0`".  On a
one-dimensional minimal coordinate subspace the family acts by scalars, and the
paper's step is the generalised `×2 ×3` argument.  This file proves it in the
form in which the project's model supplies the hypotheses:

* `x ↦ λ * x` is in the semigroup with `λ > 1` (B2 plus Lemma 4.2), and
* `x ↦ c * x` is in the semigroup with `0 < c < 1` — available in the unit–prime
  model because the units form a group, so `μ_ε` and `μ_ε⁻¹` are both members,
  and one of them contracts on the subspace;
* `log λ / log c` is irrational, i.e. the two multipliers are multiplicatively
  independent, which is corrected (B3) read on the multipliers.

Then `{λ ^ m * c ^ n : m n : ℕ}` is dense in `(0, ∞)`, every nonzero point of
`E` generates a dense half-line in `E`, and `E - E = ℝ`.  A single expanding map
does *not* suffice (`{0} ∪ {2⁻ⁿ}` is closed, infinite, proper and invariant), so
the second, independent multiplier is genuinely load-bearing: this is exactly
the obstruction recorded in the plan under §C.5.

No `axiom`, no `sorry`, no assumed `Prop`.
-/
import Mathlib

open Set Filter Topology
open scoped Pointwise

namespace CubicTwoStage
namespace BerendRankTwo

/-! ## 1. Density of the integer multiples of an irrational -/

/-- The additive subgroup generated by an irrational `θ` and `1` is dense. -/
theorem dense_zmultiples_add_one {θ : ℝ} (hθ : Irrational θ) :
    Dense (AddSubgroup.closure ({θ, 1} : Set ℝ) : Set ℝ) := by
  rw [dense_addSubgroupClosure_pair_iff]
  simpa using hθ

/-- Passing from an integer combination close to `0` to a natural multiple close
to an integer: `N` is `± A` read in `ℕ`. -/
theorem nat_near_int_of_int_near_int {θ : ℝ} {A B : ℤ} {δ : ℝ} {N : ℕ}
    (hN : (N : ℤ) = A ∨ (N : ℤ) = -A) (h : |(A : ℝ) * θ + (B : ℝ)| < δ) :
    ∃ k : ℤ, |(N : ℝ) * θ - (k : ℝ)| < δ := by
  rcases hN with hN | hN
  · refine ⟨-B, ?_⟩
    have hcast : (N : ℝ) = (A : ℝ) := by exact_mod_cast hN
    rw [hcast]
    have hkey : (A : ℝ) * θ - ((-B : ℤ) : ℝ) = (A : ℝ) * θ + (B : ℝ) := by push_cast; ring
    rw [hkey]; exact h
  · refine ⟨B, ?_⟩
    have hcast : (N : ℝ) = -(A : ℝ) := by
      have h1 : (N : ℝ) = (((-A : ℤ)) : ℝ) := by exact_mod_cast hN
      simpa using h1
    rw [hcast]
    have hkey : -(A : ℝ) * θ - (B : ℝ) = -((A : ℝ) * θ + (B : ℝ)) := by ring
    rw [hkey, abs_neg]; exact h

/-- **A nonzero integer multiple of an irrational is close to an integer, with
arbitrarily large multiplier.**  For `δ > 0` and `Q` there are `N ≥ Q` and
`k : ℤ` with `|N θ - k| < δ`. -/
theorem exists_nat_mul_sub_int_abs_lt {θ : ℝ} (hθ : Irrational θ) {δ : ℝ} (hδ : 0 < δ)
    (Q : ℕ) : ∃ N : ℕ, Q ≤ N ∧ ∃ k : ℤ, |(N : ℝ) * θ - (k : ℝ)| < δ := by
  classical
  have hdense := dense_zmultiples_add_one hθ
  set δ₀ : ℝ := min δ 1 with hδ₀def
  have hδ₀ : 0 < δ₀ := lt_min hδ zero_lt_one
  have hδ₀δ : δ₀ ≤ δ := min_le_left _ _
  have hδ₀1 : δ₀ ≤ 1 := min_le_right _ _
  set η : ℝ := δ₀ / ((Q : ℝ) + 1) with hηdef
  have hQ1 : (0 : ℝ) < (Q : ℝ) + 1 := by positivity
  have hη : 0 < η := by positivity
  have hη1 : η ≤ 1 := by
    rw [hηdef, div_le_one hQ1]
    linarith
  have hopen : IsOpen (Set.Ioo (-η) (0 : ℝ) ∪ Set.Ioo (0 : ℝ) η) :=
    isOpen_Ioo.union isOpen_Ioo
  have hne : (Set.Ioo (-η) (0 : ℝ) ∪ Set.Ioo (0 : ℝ) η).Nonempty :=
    ⟨η / 2, Or.inr ⟨by linarith, by linarith⟩⟩
  obtain ⟨y, hyD, hyU⟩ := hdense.exists_mem_open hopen hne
  obtain ⟨j, k, hjk⟩ := AddSubgroup.mem_closure_pair.1 hyD
  have hy_eq : y = (j : ℝ) * θ + (k : ℝ) := by
    rw [← hjk]; simp [zsmul_eq_mul]
  have hsmall : |y| < η := by
    rcases hyU with h | h
    · rw [abs_lt]; constructor <;> linarith [h.1, h.2]
    · rw [abs_lt]; constructor <;> linarith [h.1, h.2]
  have hyne : y ≠ 0 := by
    rintro rfl
    rcases hyU with h | h
    · linarith [h.2]
    · linarith [h.1]
  have hjne : j ≠ 0 := by
    rintro rfl
    have hyk : y = (k : ℝ) := by rw [hy_eq]; simp
    have hlt : |(k : ℝ)| < 1 := by rw [hyk] at hsmall; exact lt_of_lt_of_le hsmall hη1
    have hk0 : k = 0 := by
      have hlt' : -(1 : ℝ) < (k : ℝ) ∧ (k : ℝ) < 1 := abs_lt.1 hlt
      have hk' : -(1 : ℤ) < k ∧ k < (1 : ℤ) := by exact_mod_cast hlt'
      omega
    rw [hyk, hk0] at hyne
    exact hyne (by simp)
  -- the scaled integer combination
  set A : ℤ := ((Q + 1 : ℕ) : ℤ) * j with hAdef
  set B : ℤ := ((Q + 1 : ℕ) : ℤ) * k with hBdef
  have hscale : |(A : ℝ) * θ + (B : ℝ)| < δ₀ := by
    have h1 : (((Q + 1 : ℕ) : ℝ) * ((j : ℝ) * θ + (k : ℝ))) = (A : ℝ) * θ + (B : ℝ) := by
      rw [hAdef, hBdef]; push_cast; ring
    rw [← h1, abs_mul, abs_of_nonneg (by positivity)]
    have hcast : (((Q + 1 : ℕ) : ℝ)) = (Q : ℝ) + 1 := by push_cast; ring
    have hηeq : (((Q + 1 : ℕ) : ℝ)) * η = δ₀ := by
      rw [hηdef, hcast]; field_simp
    calc (((Q + 1 : ℕ) : ℝ)) * |(j : ℝ) * θ + (k : ℝ)|
        = (((Q + 1 : ℕ) : ℝ)) * |y| := by rw [hy_eq]
      _ < (((Q + 1 : ℕ) : ℝ)) * η := mul_lt_mul_of_pos_left hsmall (by positivity)
      _ = δ₀ := hηeq
  -- the natural multiple
  have hN : ((((Q + 1) * j.natAbs : ℕ) : ℤ) = A) ∨ ((((Q + 1) * j.natAbs : ℕ) : ℤ) = -A) := by
    have hcast : ((((Q + 1) * j.natAbs : ℕ) : ℤ)) = ((Q + 1 : ℕ) : ℤ) * ((j.natAbs : ℕ) : ℤ) := by
      push_cast; ring
    rcases le_total (0 : ℤ) j with hl | hl
    · left
      rw [hcast, Int.natAbs_of_nonneg hl, hAdef]
    · right
      have hjn : ((j.natAbs : ℕ) : ℤ) = -j := by
        have h1 : (((-j).natAbs : ℕ) : ℤ) = -j := Int.natAbs_of_nonneg (by omega)
        rwa [Int.natAbs_neg] at h1
      rw [hcast, hjn, hAdef]; ring
  obtain ⟨k', hk'⟩ := nat_near_int_of_int_near_int (N := (Q + 1) * j.natAbs) hN hscale
  refine ⟨(Q + 1) * j.natAbs, ?_, k', lt_of_lt_of_le hk' hδ₀δ⟩
  have h1 : 1 ≤ j.natAbs := by omega
  calc Q ≤ Q + 1 := Nat.le_succ Q
    _ = (Q + 1) * 1 := by rw [mul_one]
    _ ≤ (Q + 1) * j.natAbs := Nat.mul_le_mul_left _ h1


/-! ## 2. Natural multiples of an irrational are dense modulo `1` -/

/-- **The natural multiples of an irrational, shifted, hit every integer.**
For every `γ`, `ε > 0` and every lower bound `Q` there are `m ≥ Q` and `k : ℤ`
with `|m θ + γ - k| < ε`. -/
theorem exists_nat_mul_add_sub_int_abs_lt {θ : ℝ} (hθ : Irrational θ) (γ : ℝ) {ε : ℝ}
    (hε : 0 < ε) (Q : ℕ) :
    ∃ m : ℕ, Q ≤ m ∧ ∃ k : ℤ, |(m : ℝ) * θ + γ - (k : ℝ)| < ε := by
  classical
  have hdense := dense_zmultiples_add_one hθ
  have hε2 : (0 : ℝ) < ε / 2 := by linarith
  -- an integer combination `j θ + k` with `j θ + k + γ` close to `0`
  have hopen : IsOpen {y : ℝ | |y + γ| < ε / 2} :=
    isOpen_lt (f := fun y : ℝ => |y + γ|) (g := fun _ => ε / 2) (by continuity) continuous_const
  have hne : {y : ℝ | |y + γ| < ε / 2}.Nonempty := ⟨-γ, by simp; linarith⟩
  obtain ⟨y, hyD, hyU⟩ := hdense.exists_mem_open hopen hne
  obtain ⟨j, k, hjk⟩ := AddSubgroup.mem_closure_pair.1 hyD
  have hy_eq : y = (j : ℝ) * θ + (k : ℝ) := by rw [← hjk]; simp [zsmul_eq_mul]
  have hsmall : |(j : ℝ) * θ + (k : ℝ) + γ| < ε / 2 := by rw [← hy_eq]; exact hyU
  -- a large natural multiple of `θ` close to an integer
  obtain ⟨N, hNQ, k₀, hNk⟩ := exists_nat_mul_sub_int_abs_lt hθ hε2 (Q + j.natAbs)
  -- the nonnegative integer `j + N`, and `Q ≤ (j + N).toNat`
  have hjabs : -((j.natAbs : ℕ) : ℤ) ≤ j := by
    rcases le_total (0 : ℤ) j with h | h
    · rw [Int.natAbs_of_nonneg h]; linarith
    · have h1 : ((j.natAbs : ℕ) : ℤ) = -j := by
        have h2 : (((-j).natAbs : ℕ) : ℤ) = -j := Int.natAbs_of_nonneg (by omega)
        rwa [Int.natAbs_neg] at h2
      rw [h1]; linarith
  have hNge : ((j.natAbs : ℕ) : ℤ) ≤ (N : ℤ) := by
    have : j.natAbs ≤ N := by omega
    exact_mod_cast this
  have hjN : (0 : ℤ) ≤ j + N := by linarith
  have hcastm : ((((j + (N : ℤ)).toNat : ℕ) : ℝ)) = (j : ℝ) + (N : ℝ) := by
    have h1 : ((((j + (N : ℤ)).toNat : ℕ) : ℤ)) = j + N := Int.toNat_of_nonneg hjN
    have h2 := congrArg (fun z : ℤ => (z : ℝ)) h1
    push_cast at h2
    linarith [h2]
  refine ⟨((j + (N : ℤ)).toNat : ℕ), ?_, k₀ - k, ?_⟩
  · have h4 : (0 : ℤ) ≤ j + (N : ℤ) := hjN
    have h5 : ((Q : ℕ) : ℤ) ≤ ((((j + (N : ℤ)).toNat : ℕ) : ℤ)) := by
      rw [Int.toNat_of_nonneg hjN]
      have hQN : ((Q : ℕ) : ℤ) + ((j.natAbs : ℕ) : ℤ) ≤ (N : ℤ) := by exact_mod_cast hNQ
      linarith
    have h6 : Q ≤ ((j + (N : ℤ)).toNat : ℕ) := by exact_mod_cast h5
    exact h6
  · have hEq : ((((j + (N : ℤ)).toNat : ℕ) : ℝ) * θ + γ - ((k₀ - k : ℤ) : ℝ))
        = ((j : ℝ) * θ + (k : ℝ) + γ) + ((N : ℝ) * θ - (k₀ : ℝ)) := by
      rw [hcastm]; push_cast; ring
    have htri : |(((j + (N : ℤ)).toNat : ℕ) : ℝ) * θ + γ - ((k₀ - k : ℤ) : ℝ)|
        ≤ |(j : ℝ) * θ + (k : ℝ) + γ| + |(N : ℝ) * θ - (k₀ : ℝ)| := by
      rw [hEq]; exact abs_add_le _ _
    linarith [htri, hsmall, hNk]

/-! ## 3. Density of `{λ ^ m * c ^ n}` in `(0, ∞)` -/

/-- **The semigroup `{λ ^ m * c ^ n : m n : ℕ}` is dense in `(0, ∞)`** as soon
as the two multipliers are multiplicatively independent
(`log λ / log c` irrational).  This is the arithmetic content of the `×2 ×3`
step: with `λ = 2`, `c = 1/3` it says that `{2 ^ m / 3 ^ n}` is dense in
`(0, ∞)`. -/
theorem exists_pow_mul_pow_near {lam c : ℝ} (hlam : 1 < lam) (hc0 : 0 < c) (hc1 : c < 1)
    (hirr : Irrational (Real.log lam / Real.log c)) {t : ℝ} (ht : 0 < t) {ε : ℝ} (hε : 0 < ε) :
    ∃ m n : ℕ, |t - lam ^ m * c ^ n| < ε := by
  classical
  have hα : 0 < Real.log lam := Real.log_pos hlam
  have hβ : Real.log c < 0 := Real.log_neg hc0 hc1
  set ν : ℝ := -Real.log c with hνdef
  have hν : 0 < ν := by rw [hνdef]; linarith
  have hθ : Irrational (Real.log lam / ν) := by
    have h1 : Real.log lam / ν = -(Real.log lam / Real.log c) := by
      rw [hνdef]; field_simp
    rw [h1]; exact hirr.neg
  set γ : ℝ := Real.log t / ν with hγdef
  -- choose the additive tolerance
  obtain ⟨δe, hδe, hexpcont⟩ :=
    Metric.continuousAt_iff.1 (Real.continuous_exp.continuousAt (x := 0)) (ε / t) (by positivity)
  set ε' : ℝ := min (δe / (2 * ν)) 1 with hε'def
  have hε' : 0 < ε' := lt_min (by positivity) zero_lt_one
  have hε'1 : ε' ≤ 1 := min_le_right _ _
  have hε'δ : ν * ε' ≤ δe / 2 := by
    have h1 : ε' ≤ δe / (2 * ν) := min_le_left _ _
    have h2 : ν * (δe / (2 * ν)) = δe / 2 := by field_simp
    rw [← h2]; exact mul_le_mul_of_nonneg_left h1 (le_of_lt hν)
  have hδe2 : δe / 2 < δe := by linarith
  -- a lower bound forcing the contraction exponent to be nonnegative
  obtain ⟨Q, hQ⟩ := exists_nat_gt ((γ + ε' + 1) / (Real.log lam / ν))
  have hQ' : γ + ε' + 1 < (Q : ℝ) * (Real.log lam / ν) := by
    rw [div_lt_iff₀ (by positivity : (0:ℝ) < Real.log lam / ν)] at hQ
    simpa [mul_comm] using hQ
  obtain ⟨m, hmQ, k, hk⟩ := exists_nat_mul_add_sub_int_abs_lt hθ (-γ) hε' Q
  -- the contraction exponent
  have hkpos : 0 < k := by
    have hm0 : γ + ε' + 1 < (m : ℝ) * (Real.log lam / ν) := by
      have hQm : (Q : ℝ) ≤ (m : ℝ) := by exact_mod_cast hmQ
      have hθpos : 0 < Real.log lam / ν := by positivity
      have hstep : (Q : ℝ) * (Real.log lam / ν) ≤ (m : ℝ) * (Real.log lam / ν) :=
        mul_le_mul_of_nonneg_right hQm (le_of_lt hθpos)
      linarith
    have h1 : (m : ℝ) * (Real.log lam / ν) + -γ - (k : ℝ) < ε' := (abs_lt.1 hk).2
    have h2 : γ + ε' < (m : ℝ) * (Real.log lam / ν) := by linarith
    have h3 : (k : ℝ) > 0 := by linarith
    have hk0 : (0 : ℤ) < k := by exact_mod_cast h3
    exact hk0
  set n : ℕ := k.toNat with hndef
  have hncast : (n : ℝ) = (k : ℝ) := by
    have h1 : ((k.toNat : ℕ) : ℤ) = k := Int.toNat_of_nonneg (le_of_lt hkpos)
    have h2 := congrArg (fun z : ℤ => (z : ℝ)) h1
    push_cast at h2
    rw [hndef]; exact h2
  -- the logarithmic error
  set w : ℝ := (m : ℝ) * Real.log lam + (n : ℝ) * Real.log c - Real.log t with hwdef
  have hw : |w| < δe := by
    have hlogeq : Real.log lam = ν * (Real.log lam / ν) := by field_simp
    have hkey : w = ν * ((m : ℝ) * (Real.log lam / ν) + (-γ) - (k : ℝ)) := by
      rw [hwdef, hγdef, hncast]
      field_simp
      ring
    rw [hkey, abs_mul, abs_of_nonneg (le_of_lt hν)]
    calc ν * |(m : ℝ) * (Real.log lam / ν) + -γ - (k : ℝ)| < ν * ε' := by
          exact mul_lt_mul_of_pos_left hk hν
      _ ≤ δe / 2 := hε'δ
      _ < δe := hδe2
  -- conclude
  have hexp : |Real.exp w - 1| < ε / t := by
    have h1 := hexpcont (x := w) (by simpa [Real.dist_eq] using hw)
    simpa [Real.dist_eq] using h1
  have hprod : lam ^ m * c ^ n = t * Real.exp w := by
    have h1 : lam ^ m = Real.exp ((m : ℝ) * Real.log lam) := by
      rw [Real.exp_nat_mul, Real.exp_log (by linarith)]
    have h2 : c ^ n = Real.exp ((n : ℝ) * Real.log c) := by
      rw [Real.exp_nat_mul, Real.exp_log hc0]
    have hsplit : (m : ℝ) * Real.log lam + (n : ℝ) * Real.log c = Real.log t + w := by
      rw [hwdef]; ring
    rw [h1, h2, ← Real.exp_add, hsplit, Real.exp_add, Real.exp_log ht]
  refine ⟨m, n, ?_⟩
  rw [hprod]
  have hexp' : |1 - Real.exp w| < ε / t := by rw [abs_sub_comm]; exact hexp
  have hfac : t - t * Real.exp w = t * (1 - Real.exp w) := by ring
  rw [hfac, abs_mul, abs_of_pos ht]
  calc t * |1 - Real.exp w| < t * (ε / t) := mul_lt_mul_of_pos_left hexp' ht
    _ = ε := by field_simp

/-! ## 4. The rank-two expansion theorem -/

/-- **The `×2 ×3` step, one-dimensional form.**  If `E ⊆ ℝ` is closed and
invariant under the expanding map `x ↦ lam * x` (`lam > 1`) and the contracting
map `x ↦ c * x` (`0 < c < 1`), if the multipliers are multiplicatively
independent and `E` contains a nonzero point, then `E - E` is all of `ℝ`: in
particular `E - E` contains a neighbourhood of `0`.

This is the conclusion stage C.4 needs on a one-dimensional minimal coordinate
subspace: the difference set of the invariant set meets the hypothesis of the
covering lemma `AddCircle.sub_eq_univ_of_ball_subset`. -/
theorem sub_eq_univ_of_invariant {E : Set ℝ} {lam c : ℝ}
    (hlam : 1 < lam) (hc0 : 0 < c) (hc1 : c < 1)
    (hirr : Irrational (Real.log lam / Real.log c))
    (hclosed : IsClosed E)
    (hexp : ∀ y ∈ E, lam * y ∈ E) (hcon : ∀ y ∈ E, c * y ∈ E)
    {x : ℝ} (hxE : x ∈ E) (hx0 : x ≠ 0) :
    E - E = Set.univ := by
  -- iterates of the two maps
  have hlamE : ∀ m : ℕ, lam ^ m * x ∈ E := by
    intro m
    induction m with
    | zero => simpa using hxE
    | succ m ih =>
        have : lam ^ (m + 1) * x = lam * (lam ^ m * x) := by ring
        rw [this]; exact hexp _ ih
  have hcE : ∀ n : ℕ, c ^ n * x ∈ E := by
    intro n
    induction n with
    | zero => simpa using hxE
    | succ n ih =>
        have : c ^ (n + 1) * x = c * (c ^ n * x) := by ring
        rw [this]; exact hcon _ ih
  have hprodE : ∀ m n : ℕ, lam ^ m * (c ^ n * x) ∈ E := by
    intro m n
    induction m with
    | zero => simpa using hcE n
    | succ m ih =>
        have : lam ^ (m + 1) * (c ^ n * x) = lam * (lam ^ m * (c ^ n * x)) := by ring
        rw [this]; exact hexp _ ih
  -- `0 ∈ E`
  have hzero : (0 : ℝ) ∈ E := by
    have htend : Tendsto (fun n : ℕ => c ^ n * x) atTop (𝓝 0) := by
      have h1 := tendsto_pow_atTop_nhds_zero_of_lt_one (le_of_lt hc0) hc1
      simpa using h1.mul_const x
    exact hclosed.mem_of_tendsto htend (Eventually.of_forall fun n => hcE n)
  -- every point of the half-line determined by `x` lies in `E`
  have hmem : ∀ t : ℝ, 0 ≤ t / x → t ∈ E := by
    intro t ht
    rcases eq_or_lt_of_le ht with h0 | hpos
    · have h1 : t = 0 := by
        rcases div_eq_zero_iff.1 h0.symm with h | h
        · exact h
        · exact absurd h hx0
      rw [h1]; exact hzero
    · have hcl : t ∈ closure E := by
        rw [Metric.mem_closure_iff]
        intro ε hε
        have hxpos : 0 < |x| := abs_pos.2 hx0
        obtain ⟨m, n, hmn⟩ :=
          exists_pow_mul_pow_near hlam hc0 hc1 hirr hpos (show 0 < ε / |x| by positivity)
        refine ⟨lam ^ m * (c ^ n * x), hprodE m n, ?_⟩
        rw [Real.dist_eq]
        have hfac : t - lam ^ m * (c ^ n * x) = x * (t / x - lam ^ m * c ^ n) := by
          field_simp
        rw [hfac, abs_mul]
        calc |x| * |t / x - lam ^ m * c ^ n| < |x| * (ε / |x|) :=
              mul_lt_mul_of_pos_left hmn hxpos
          _ = ε := by field_simp
      rwa [hclosed.closure_eq] at hcl
  -- one of the two half-lines is contained in `E`
  have hcase : Set.Ici (0 : ℝ) ⊆ E ∨ Set.Iic (0 : ℝ) ⊆ E := by
    rcases lt_or_gt_of_ne hx0.symm with hxpos | hxneg
    · left
      intro t ht
      exact hmem t (div_nonneg (mem_Ici.1 ht) (le_of_lt hxpos))
    · right
      intro t ht
      refine hmem t ?_
      have h1 : t / x = (-t) / (-x) := (neg_div_neg_eq t x).symm
      rw [h1]
      exact div_nonneg (by linarith [mem_Iic.1 ht]) (by linarith)
  refine Set.eq_univ_of_forall fun y => ?_
  rcases hcase with hcase | hcase
  · refine Set.mem_sub.2 ⟨y + |y|, hcase (Set.mem_Ici.2 (by
      have h1 := neg_le_abs y; have h2 := abs_nonneg y; linarith)),
      |y|, hcase (Set.mem_Ici.2 (abs_nonneg y)), ?_⟩
    ring
  · refine Set.mem_sub.2 ⟨y - |y|, hcase (Set.mem_Iic.2 (by
      have h1 := le_abs_self y; linarith)),
      -(|y|), hcase (Set.mem_Iic.2 (by
      have h1 := abs_nonneg y; linarith)), ?_⟩
    ring

/-! ## 5. Multiplicative independence of the multipliers gives an irrational log
ratio

Corrected (B3) of the plan, read on the multipliers of a one-dimensional
minimal subspace, has exactly the form

`∀ l k : ℤ, lam ^ l = c ^ k → l = 0 ∧ k = 0`

(`RationallyIndependentPair` applied to `μ_π` and `μ_ε`).  This is the
hypothesis the density theorem above consumes.  Note that the *product* form
`lam ^ l * c ^ k = 1 → l = 0 ∧ k = 0` for natural exponents would be strictly
weaker and insufficient: `2 ^ 2 * 4 ^ (-1) = 1` shows it holds for `2` and `4`,
whose log ratio is `1/2`. -/

/-- **Multiplicative independence of two positive reals gives an irrational log
ratio**: if no nontrivial integer powers of `a` and `b` coincide, then
`log a / log b` is irrational. -/
theorem irrational_log_div_log_of_indep {a b : ℝ} (ha : 0 < a) (hb : 0 < b)
    (hind : ∀ m n : ℤ, a ^ m = b ^ n → m = 0 ∧ n = 0) :
    Irrational (Real.log a / Real.log b) := by
  rintro ⟨r, hr⟩
  have hb1 : b ≠ 1 := by
    rintro rfl
    have h := hind 0 1 (by simp)
    omega
  have hlogb : Real.log b ≠ 0 := by
    intro h0
    rw [Real.log_eq_zero] at h0
    rcases h0 with h | h | h
    · linarith
    · exact hb1 h
    · linarith
  -- real value of the rational
  have hr' : (r : ℝ) = (r.num : ℝ) / (r.den : ℝ) := by
    have h : ((r.num : ℚ) / (r.den : ℚ) : ℚ) = r := Rat.num_div_den r
    calc (r : ℝ) = (((r.num : ℚ) / (r.den : ℚ) : ℚ) : ℝ) := by rw [h]
      _ = (r.num : ℝ) / (r.den : ℝ) := by
          rw [Rat.cast_div, Rat.cast_intCast, Rat.cast_natCast]
  have h2 : Real.log a / Real.log b = (r.num : ℝ) / (r.den : ℝ) := by rw [← hr, hr']
  have hlog : ((r.den : ℕ) : ℝ) * Real.log a = (r.num : ℝ) * Real.log b := by
    field_simp [hlogb] at h2
    linarith [h2]
  have hpow : a ^ ((r.den : ℕ) : ℤ) = b ^ (r.num : ℤ) := by
    refine Real.log_injOn_pos (zpow_pos ha _) (zpow_pos hb _) ?_
    rw [Real.log_zpow, Real.log_zpow]
    push_cast
    linarith [hlog]
  have hres := hind _ _ hpow
  have hpos : (0 : ℤ) < (r.den : ℤ) := by exact_mod_cast r.den_pos
  omega

/-! ## 6. The theorem in the shape of corrected (B3)

Corrected (B3) is `RationallyIndependentPair`, i.e. for the two witnesses
`∀ l k : ℤ, f l ^ l = f k ^ k → l = 0 ∧ k = 0`.  On a one-dimensional minimal
subspace where the two maps act by the scalars `lam` and `c`, that hypothesis
reads exactly `∀ l k : ℤ, lam ^ l = c ^ k → l = 0 ∧ k = 0`.  With §5 this is
enough to run the expansion theorem, with no arithmetic left to prove. -/

/-- **The `×2 ×3` step from corrected (B3).**  If `E ⊆ ℝ` is closed and invariant
under `x ↦ lam * x` (`lam > 1`) and `x ↦ c * x` (`0 < c < 1`), and the two
multipliers satisfy the exponent independence of corrected (B3), then every
nonzero point of `E` forces `E - E = ℝ`. -/
theorem sub_eq_univ_of_invariant_of_indep {E : Set ℝ} {lam c : ℝ}
    (hlam : 1 < lam) (hc0 : 0 < c) (hc1 : c < 1)
    (hind : ∀ m n : ℤ, lam ^ m = c ^ n → m = 0 ∧ n = 0)
    (hclosed : IsClosed E)
    (hexp : ∀ y ∈ E, lam * y ∈ E) (hcon : ∀ y ∈ E, c * y ∈ E)
    {x : ℝ} (hxE : x ∈ E) (hx0 : x ≠ 0) :
    E - E = Set.univ :=
  sub_eq_univ_of_invariant hlam hc0 hc1
    (irrational_log_div_log_of_indep (lt_trans zero_lt_one hlam) hc0 hind)
    hclosed hexp hcon hxE hx0

/-! ## 7. The concrete instance `×2`, `÷3`

The numbers `2` and `3` are multiplicatively independent, so `2` and `1/3` are,
and the expansion theorem applies: *every closed set `E ⊆ ℝ` that is invariant
under `x ↦ 2x` and `x ↦ x/3` and contains a nonzero point has `E - E = ℝ`. -/

/-- `2` and `3` are multiplicatively independent at the level of natural
powers. -/
theorem two_pow_eq_three_pow {m n : ℕ} (h : 2 ^ m = 3 ^ n) : m = 0 ∧ n = 0 := by
  have hm : m = 0 := by
    by_contra hm
    have h2 : (2 : ℕ) ∣ 3 ^ n := by
      rw [← h]
      exact dvd_pow_self 2 hm
    have := Nat.Prime.dvd_of_dvd_pow (by norm_num : Nat.Prime 2) h2
    norm_num at this
  subst hm
  refine ⟨rfl, ?_⟩
  have h1 : 3 ^ n = 1 := by rw [← h]; norm_num
  by_contra hn
  have h3 : (3 : ℕ) ∣ 3 ^ n := dvd_pow_self 3 hn
  rw [h1] at h3
  exact absurd h3 (by norm_num)

/-- Uniqueness of the `2`-`3` factorisation of a natural number. -/
theorem two_three_factor_unique {A B C D : ℕ} (h : 2 ^ A * 3 ^ B = 2 ^ C * 3 ^ D) :
    A = C ∧ B = D := by
  have key : ∀ A C B D : ℕ, 2 ^ A * 3 ^ B = 2 ^ C * 3 ^ D → A ≤ C → A = C := by
    intro A C B D h hle
    have h2 : 2 ^ A * 3 ^ B = 2 ^ A * (2 ^ (C - A) * 3 ^ D) := by
      rw [h, ← mul_assoc, ← pow_add, Nat.add_sub_cancel' hle]
    have h3 : 3 ^ B = 2 ^ (C - A) * 3 ^ D :=
      Nat.mul_left_cancel (by positivity) h2
    have hdvd : 2 ^ (C - A) ∣ 3 ^ B := ⟨3 ^ D, by rw [h3]⟩
    have hcop : Nat.Coprime (2 ^ (C - A)) (3 ^ B) :=
      Nat.Coprime.pow _ _ (by norm_num)
    have hone : 2 ^ (C - A) = 1 := hcop.eq_one_of_dvd hdvd
    rcases Nat.eq_zero_or_pos (C - A) with h0 | hpos
    · omega
    · exfalso
      have hlt : 1 < 2 ^ (C - A) := Nat.one_lt_pow (by omega) (by norm_num)
      omega
  rcases le_total A C with hle | hle
  · have hAC : A = C := key A C B D h hle
    refine ⟨hAC, ?_⟩
    rw [hAC] at h
    have : 3 ^ B = 3 ^ D := Nat.mul_left_cancel (by positivity) h
    exact Nat.pow_right_injective (by norm_num) this
  · have hCA : C = A := key C A D B h.symm hle
    refine ⟨hCA.symm, ?_⟩
    rw [hCA] at h
    have : 3 ^ B = 3 ^ D := Nat.mul_left_cancel (by positivity) h
    exact Nat.pow_right_injective (by norm_num) this

/-- `a ^ k` for negative `k` is below `1`. -/
theorem zpow_lt_one_of_neg {a : ℝ} (ha : 1 < a) {k : ℤ} (hk : k < 0) : a ^ k < 1 := by
  have h1 : a ^ k = ((a ^ (-k))⁻¹) := by
    rw [← zpow_neg]; congr 1; ring
  rw [h1]
  have h2 : (1 : ℝ) < a ^ (-k) := by
    rw [← Int.toNat_of_nonneg (by omega : (0:ℤ) ≤ -k), zpow_natCast]
    exact one_lt_pow₀ ha (by omega)
  exact inv_lt_one_of_one_lt₀ h2

/-- `a ^ k` for nonnegative `k` is at least `1`. -/
theorem one_le_zpow_of_nonneg {a : ℝ} (ha : 1 ≤ a) {k : ℤ} (hk : 0 ≤ k) : 1 ≤ a ^ k := by
  rw [← Int.toNat_of_nonneg hk, zpow_natCast]
  exact one_le_pow₀ ha

/-- Sign test: a nonnegative power of `3` is at least `1`. -/
theorem three_zpow_pos_imp {a : ℤ} (ha : (1 : ℝ) ≤ (3 : ℝ) ^ a) : 0 ≤ a := by
  by_contra h
  have hlt : (3 : ℝ) ^ a < 1 := zpow_lt_one_of_neg (by norm_num) (by omega)
  linarith

/-- Sign test: a power of `3` below `1` has negative exponent. -/
theorem three_zpow_lt_one_imp {a : ℤ} (ha : (3 : ℝ) ^ a < 1) : a < 0 := by
  by_contra h
  have hge : (1 : ℝ) ≤ (3 : ℝ) ^ a := one_le_zpow_of_nonneg (by norm_num) (by omega)
  linarith

/-- **`2` and `1/3` are multiplicatively independent** in the exponent form of
corrected (B3). -/
theorem two_one_third_indep : ∀ m n : ℤ, (2 : ℝ) ^ m = ((1 : ℝ) / 3) ^ n → m = 0 ∧ n = 0 := by
  intro m n h
  have h1 : ((1 : ℝ) / 3) ^ n = (3 : ℝ) ^ (-n) := by
    rw [one_div, inv_zpow]; exact (zpow_neg (3 : ℝ) n).symm
  rw [h1] at h
  -- compare with naturals via the prime factorisation of `2 ^ a * 3 ^ b`
  have toNat_eq : ∀ a b : ℕ, (2 : ℝ) ^ (a : ℤ) = (3 : ℝ) ^ (b : ℤ) → a = 0 ∧ b = 0 := by
    intro a b hab
    have hnat : (2 : ℕ) ^ a = (3 : ℕ) ^ b := by
      have hcast : ((2 : ℕ) ^ a : ℝ) = ((3 : ℕ) ^ b : ℝ) := by
        rw [← zpow_natCast, ← zpow_natCast]; exact hab
      exact_mod_cast hcast
    exact two_pow_eq_three_pow hnat
  rcases lt_or_ge m 0 with hmneg | hmge
  · -- `m < 0` forces `n > 0`; invert the relation
    have hlt : (2 : ℝ) ^ m < 1 := zpow_lt_one_of_neg (by norm_num) hmneg
    have h3 : (3 : ℝ) ^ (-n) < 1 := by rw [← h]; exact hlt
    have hn : 0 < n := by have := three_zpow_lt_one_imp h3; omega
    have hinv : (2 : ℝ) ^ (-m) = (3 : ℝ) ^ n := by
      have h2 := congrArg (fun z : ℝ => z⁻¹) h
      simpa [zpow_neg] using h2
    have hinv' : (2 : ℝ) ^ (((-m).toNat : ℕ) : ℤ) = (3 : ℝ) ^ ((n.toNat : ℕ) : ℤ) := by
      rw [Int.toNat_of_nonneg (by omega : (0:ℤ) ≤ -m), Int.toNat_of_nonneg (by omega : (0:ℤ) ≤ n)]
      exact hinv
    have hkey : ((-m).toNat) = 0 ∧ n.toNat = 0 := toNat_eq _ _ hinv'
    omega
  · -- `m ≥ 0` forces `n ≤ 0`
    have hge : (1 : ℝ) ≤ (2 : ℝ) ^ m := one_le_zpow_of_nonneg (by norm_num) hmge
    have h3 : (1 : ℝ) ≤ (3 : ℝ) ^ (-n) := by rw [← h]; exact hge
    have hn : 0 ≤ -n := three_zpow_pos_imp h3
    have h' : (2 : ℝ) ^ ((m.toNat : ℕ) : ℤ) = (3 : ℝ) ^ (((-n).toNat : ℕ) : ℤ) := by
      rw [Int.toNat_of_nonneg hmge, Int.toNat_of_nonneg hn]
      exact h
    have hkey : m.toNat = 0 ∧ (-n).toNat = 0 := toNat_eq _ _ h'
    omega

/-- **The concrete `×2`, `÷3` expansion theorem**: a closed `E ⊆ ℝ` invariant
under `x ↦ 2x` and `x ↦ x/3` and containing a nonzero point has `E - E = ℝ`.
This is the `×2 ×3` step with the multiplicative group generated by `2` and `3`
in place of the semigroup. -/
theorem sub_eq_univ_of_invariant_two_div_three {E : Set ℝ} (hclosed : IsClosed E)
    (hexp : ∀ y ∈ E, 2 * y ∈ E) (hcon : ∀ y ∈ E, (1 / 3 : ℝ) * y ∈ E)
    {x : ℝ} (hxE : x ∈ E) (hx0 : x ≠ 0) :
    E - E = Set.univ :=
  sub_eq_univ_of_invariant_of_indep (by norm_num) (by norm_num) (by norm_num)
    two_one_third_indep hclosed hexp hcon hxE hx0

end BerendRankTwo
end CubicTwoStage
