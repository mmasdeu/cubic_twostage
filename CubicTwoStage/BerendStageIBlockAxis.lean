/-
# Stage I for the block model: the axis branch, unconditionally

Swarm `smw9665xe`, member `m3`, direction `d2` (genuine Stage I).

`BEREND_SEC5_NOTES.md` records that Stage I for the actual model
`Pt = ℝ × ℂ`, `μ_{uπ^j} ⋆ x`, splits by Berend's Lemma 4.1 into the two invariant
subspaces of the family, the real axis `coord {0}` and the complex plane
`cplxPlane = {x | x 0 = 0}`.  The plane branch is the deep one
(`BerendBlockLastMile.zeroNonisolatedFull_iff_unboundedPlane`).  **This file closes
the axis branch unconditionally**, with no annulus input, no `CofinalPlane`, and no
density of multipliers at the complex place.

The two new mathematical points are:

* **Term balancing.**  Let `c = D.unit_image ε` be a unit multiplier with
  `lam = |c 0| > 1`.  Since `|normR c| = 1` we have `‖cplxOf c‖² = lam⁻¹`, i.e. the
  complex block *shrinks* at rate `lam^{-1/2}` when the real block grows at rate
  `lam`.  So for a lift point `x ≠ 0` one can choose `m` with
  `1 ≤ lam^m |x 0| ≤ lam` (a compact window away from `0`), and then the complex
  coordinates of `(D.actU ε)^[m] x` are bounded by `‖x‖`, hence tend to `0` when
  `x → 0`.  Iterating such points therefore produces a **nonzero point of the real
  axis** in the lift.  This is where the cubic block structure enters: the complex
  modulus is the inverse square root of the real one, so normalising the real
  coordinate kills the complex one.
* **The axis generates the torus.**  A nonzero axis point `a • e 0` in the lift is
  spread by the unit multipliers to a dense set of axis points
  (`{μ 0}` dense in `ℝ`), and the closed subgroup generated by the axis image is
  everything: a nonzero integral functional killing the axis has `k₁ = 0`, hence is
  `(0, k₂, k₃)`, hence `l(σ₂ n) ∈ ℤ` for all lattice points `n`, impossible because
  the complex projection of the lattice is dense.

Together: if `0` is a non-isolated point of a closed invariant `Y` and the lift
accumulates at `0` along points with **nonzero real coordinate**, then `Y = univ`.
Equivalently, the only remaining case of Stage I is the purely *planar*
accumulation, which is the exact statement isolated in
`BerendBlockLastMile.zeroNonisolatedFull_iff_unboundedPlane`.

No `sorry`, no `axiom`, no assumed `Prop` beyond the explicitly printed density
hypotheses `hscal`, `haxis` (both arithmetic facts about the model, not about the
dynamics).  The old axiom `berend_multi_invariance` is imported transitively
(`FieldModel → Uncovered → Berend`) and is not used; the audit at the end shows
only `propext`, `Classical.choice`, `Quot.sound`.
-/
import CubicTwoStage.BerendAxisDensity
import CubicTwoStage.BerendBlockLastMile
import CubicTwoStage.BerendEigenBridge

open Set Filter Topology
open scoped Pointwise

set_option maxHeartbeats 2000000
set_option linter.unusedSectionVars false

namespace CubicTwoStage
namespace BerendStageIBlock

variable {K : Type*} [Field K] {L : AddSubgroup Pt} {𝒪 : Subring K}

/-! ## 1. The block action on the real axis is a scalar -/

lemma mulC_smul_e_zero (a : Pt) (t : ℝ) :
    a ⋆ (t • BerendModulus.e (0 : Fin 3)) = (a 0 * t) • BerendModulus.e (0 : Fin 3) := by
  funext j
  fin_cases j <;> simp [BerendModulus.e, mulC]

/-! ## 2. Invariance of the lift -/

/-- The lift `π⁻¹ Y` of a family-invariant `Y` is invariant under every family
action. -/
theorem preimage_invariant (D : UnitPrimeModel L 𝒪) {Y : Set (Torus L)}
    (hinv : ∀ i, D.torusAct i '' Y ⊆ Y) (i : 𝒪ˣ × ℕ) {x : Pt}
    (hx : (QuotientAddGroup.mk' L) x ∈ Y) :
    (QuotientAddGroup.mk' L) (D.family.act i x) ∈ Y := by
  have h := hinv i (Set.mem_image_of_mem (D.torusAct i) hx)
  rwa [D.torusAct_mk'] at h

/-! ## 3. A nonzero axis point fills the torus -/

/-- **Axis branch of Stage I.**  A closed family-invariant `Y` that contains the
class of one nonzero point `a • e 0` of the real axis is the whole torus, provided
`{μ 0 : μ}` is dense in `ℝ` (so the unit multipliers spread the axis point to a
dense set of scalars) and `coord {0} + L` is dense (so the axis image is dense).

Nothing here uses the annulus input; the theorem is the exact last mile of
Berend's Lemma 4.1 branch `S = {real coordinate}` for the block model. -/
theorem eq_univ_of_axis_point (D : UnitPrimeModel L 𝒪) {Y : Set (Torus L)}
    (hY : IsClosed Y) (hinv : ∀ i, D.torusAct i '' Y ⊆ Y)
    {a : ℝ} (ha : a ≠ 0)
    (hpt : (QuotientAddGroup.mk' L) (a • BerendModulus.e (0 : Fin 3)) ∈ Y)
    (hscal : Dense (Set.range fun i : 𝒪ˣ × ℕ => (D.mult i.1 i.2) 0))
    (haxis : Dense ((BerendSec4.coord ({0} : Set (Fin 3)) : Set Pt) + (L : Set Pt))) :
    Y = univ := by
  have hA : Dense (Set.range fun i : 𝒪ˣ × ℕ => (D.mult i.1 i.2) 0 * a) :=
    BerendAxis.dense_range_mul hscal ha
  refine BerendAxis.eq_univ_of_dense_axis_points (ι := Fin 3) (i := 0) hY hA ?_
    (BerendAxis.dense_axis_image haxis)
  rintro t ⟨i, rfl⟩
  have h := preimage_invariant D hinv i hpt
  have h1 : D.family.act i (a • BerendModulus.e (0 : Fin 3)) =
      ((D.mult i.1 i.2) 0 * a) • BerendModulus.e (0 : Fin 3) := by
    rw [D.family_apply, mulC_smul_e_zero]
  rwa [h1] at h

/-! ## 4. The block action of a unit, coordinatewise -/

lemma cplxOf_oneC : cplxOf oneC = 1 := by
  apply Complex.ext <;> simp [cplxOf, oneC]

lemma cplxOf_powC (c : Pt) (n : ℕ) : cplxOf (powC c n) = (cplxOf c) ^ n := by
  induction n with
  | zero => simp [powC_zero, cplxOf_oneC]
  | succ n ih => rw [powC_succ, cplxOf_mulC, ih, pow_succ']

lemma powC_apply_zero (c : Pt) (n : ℕ) : (powC c n) 0 = (c 0) ^ n := by
  induction n with
  | zero => simp [powC_zero, oneC]
  | succ n ih => rw [powC_succ, mulC_apply_zero, ih, pow_succ']

lemma normC_powC (c : Pt) (n : ℕ) : normC (powC c n) = (normC c) ^ n := by
  induction n with
  | zero => simp [powC_zero, oneC, normC]
  | succ n ih => rw [powC_succ, normC_mulC, ih, pow_succ']

lemma unit_image_pow (D : UnitPrimeModel L 𝒪) (u : 𝒪ˣ) (n : ℕ) :
    D.unit_image (u ^ n) = powC (D.unit_image u) n := by
  induction n with
  | zero => rw [pow_zero, D.unit_one, powC_zero]
  | succ n ih => rw [pow_succ, D.unit_mul, ih, powC_succ, mulC_comm]

/-- The real coordinate of the `n`-th iterate of the unit action. -/
theorem actU_iterate_zero (D : UnitPrimeModel L 𝒪) (u : 𝒪ˣ) (n : ℕ) (x : Pt) :
    ((D.actU u)^[n] x) 0 = (D.unit_image u 0) ^ n * x 0 := by
  rw [← D.actU_pow u n x, D.actU_apply, unit_image_pow, mulC_apply_zero, powC_apply_zero]

/-- The complex coordinate of the `n`-th iterate of the unit action. -/
theorem actU_iterate_cplx (D : UnitPrimeModel L 𝒪) (u : 𝒪ˣ) (n : ℕ) (x : Pt) :
    cplxOf (((D.actU u)^[n] x)) = (cplxOf (D.unit_image u)) ^ n * cplxOf x := by
  rw [← D.actU_pow u n x, D.actU_apply, unit_image_pow, cplxOf_mulC, cplxOf_powC]

lemma norm_cplxOf_le (x : Pt) : ‖cplxOf x‖ ≤ 2 * ‖x‖ := by
  have h1 : |x 1| ≤ ‖x‖ := norm_le_pi_norm x 1
  have h2 : |x 2| ≤ ‖x‖ := norm_le_pi_norm x 2
  calc ‖cplxOf x‖ ≤ |x 1| + |x 2| := Complex.norm_le_abs_re_add_abs_im _
    _ ≤ ‖x‖ + ‖x‖ := by linarith
    _ = 2 * ‖x‖ := by ring

/-! ## 5. Term balancing: non-planar accumulation reaches the axis -/

/-- **Term balancing.**  Let `c = D.unit_image ε` have `1 < |c 0|` and
`|normR c| = 1` (so the complex block shrinks as `|c 0|^{-1/2}`).  If the lift `E`
is closed, family-invariant, and `0` is a non-isolated point of
`E ∩ {x | x 0 ≠ 0}`, then `E` contains a nonzero point of the real axis. -/
theorem exists_axis_point_of_acc (D : UnitPrimeModel L 𝒪) (ε : 𝒪ˣ)
    (hε1 : 1 < |D.unit_image ε 0|)
    (hεN : |normR (D.unit_image ε)| = 1)
    {E : Set Pt} (hE : IsClosed E)
    (hinvE : ∀ i x, x ∈ E → D.family.act i x ∈ E)
    (hacc : (0 : Pt) ∈ closure (E ∩ {x | x 0 ≠ 0})) :
    ∃ a : ℝ, a ≠ 0 ∧ a • BerendModulus.e (0 : Fin 3) ∈ E := by
  classical
  set c : Pt := D.unit_image ε with hcdef
  set lam : ℝ := |c 0| with hlamdef
  -- the shrinking rate of the complex block
  have hlampos : 0 < lam := lt_trans zero_lt_one hε1
  have hcnorm : lam * normC c = 1 := by
    have h := hεN
    rw [normR_eq_mul_normC, abs_mul, abs_of_nonneg (normC_nonneg c)] at h
    simpa [hlamdef] using h
  have hmu1 : ‖cplxOf c‖ ^ 2 * lam = 1 := by
    have h2 : ‖cplxOf c‖ ^ 2 = normC c := by
      rw [normC_eq_normSq, Complex.normSq_eq_norm_sq]
    rw [h2, mul_comm]
    exact hcnorm
  have hmu_le : ‖cplxOf c‖ ≤ 1 := by nlinarith [norm_nonneg (cplxOf c)]
  -- a sequence in `E ∩ {x 0 ≠ 0}` tending to `0`
  obtain ⟨x, hxE, hxtend⟩ := mem_closure_iff_seq_limit.mp hacc
  have hxne : ∀ n, x n 0 ≠ 0 := fun n => (hxE n).2
  have hxE' : ∀ n, x n ∈ E := fun n => (hxE n).1
  -- shave so that `‖x n‖ ≤ 1` from the start
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hxtend 1 zero_lt_one
  set xs : ℕ → Pt := fun n => x (n + N) with hxsdef
  have hxsE : ∀ n, xs n ∈ E := fun n => hxE' (n + N)
  have hxsne : ∀ n, xs n 0 ≠ 0 := fun n => hxne (n + N)
  have hxsb : ∀ n, ‖xs n‖ ≤ 1 := fun n => by
    have h := hN (n + N) (Nat.le_add_left N n)
    rw [dist_zero_right] at h
    exact le_of_lt h
  have hxstend : Tendsto xs atTop (𝓝 0) := by
    have : Tendsto (fun n : ℕ => x (n + N)) atTop (𝓝 0) :=
      hxtend.comp (tendsto_add_atTop_nat N)
    exact this
  -- choose the scaling exponent
  have hex : ∀ n, ∃ m : ℕ, 1 ≤ lam ^ m * |xs n 0| := by
    intro n
    have hpos : 0 < |xs n 0| := abs_pos.mpr (hxsne n)
    have hmono : Tendsto (fun m : ℕ => lam ^ m * |xs n 0|) atTop atTop :=
      (tendsto_pow_atTop_atTop_of_one_lt hε1).atTop_mul_const hpos
    exact (hmono.eventually (eventually_ge_atTop 1)).exists
  set m : ℕ → ℕ := fun n => Nat.find (hex n) with hmdef
  have hm_spec : ∀ n, 1 ≤ lam ^ (m n) * |xs n 0| := fun n => Nat.find_spec (hex n)
  have hm_min : ∀ n k, k < m n → ¬ (1 ≤ lam ^ k * |xs n 0|) :=
    fun n k hk => Nat.find_min (hex n) hk
  -- the scaled points
  set y : ℕ → Pt := fun n => (D.actU ε)^[m n] (xs n) with hydef
  have hyE : ∀ n, y n ∈ E := by
    intro n
    have h1 : y n = D.family.act (ε ^ m n, 0) (xs n) := by
      rw [D.family_act_zero, D.actU_pow ε (m n) (xs n)]
    rw [h1]
    exact hinvE _ _ (hxsE n)
  have hy0 : ∀ n, |y n 0| = lam ^ (m n) * |xs n 0| := by
    intro n
    have h := actU_iterate_zero D ε (m n) (xs n)
    simp only [hydef]
    rw [h, abs_mul, abs_pow, ← hlamdef]
  have hy1 : ∀ n, 1 ≤ |y n 0| := by
    intro n
    rw [hy0 n]
    exact hm_spec n
  have hy2 : ∀ n, |y n 0| ≤ lam := by
    intro n
    rw [hy0 n]
    rcases Nat.eq_zero_or_pos (m n) with h0 | hpos
    · rw [h0, pow_zero, one_mul]
      have h1 : |xs n 0| ≤ ‖xs n‖ := by simpa using norm_le_pi_norm (xs n) 0
      linarith [hxsb n, hε1]
    · have hlt : ¬ (1 ≤ lam ^ (m n - 1) * |xs n 0|) := hm_min n (m n - 1) (Nat.sub_one_lt hpos.ne')
      have hlt' : lam ^ (m n - 1) * |xs n 0| < 1 := lt_of_not_ge hlt
      have hm1 : m n = (m n - 1) + 1 := (Nat.sub_one_add_one hpos.ne').symm
      have hk : lam ^ (m n) = lam ^ (m n - 1) * lam := by
        conv_lhs => rw [hm1]
        rw [pow_succ]
      have hsucc : lam ^ (m n) * |xs n 0| = lam * (lam ^ (m n - 1) * |xs n 0|) := by
        rw [hk]; ring
      rw [hsucc]
      nlinarith [hlt', hlampos]
  have hyC : ∀ n, ‖cplxOf (y n)‖ ≤ 2 * ‖xs n‖ := by
    intro n
    have h1 : cplxOf (y n) = (cplxOf c) ^ (m n) * cplxOf (xs n) := by
      have h := actU_iterate_cplx D ε (m n) (xs n)
      simp only [hydef]
      rw [h, hcdef]
    rw [h1, norm_mul, norm_pow]
    have h2 : ‖cplxOf c‖ ^ (m n) ≤ 1 := pow_le_one₀ (norm_nonneg _) hmu_le
    calc ‖cplxOf c‖ ^ (m n) * ‖cplxOf (xs n)‖
        ≤ 1 * ‖cplxOf (xs n)‖ := by
          exact mul_le_mul_of_nonneg_right h2 (norm_nonneg _)
      _ = ‖cplxOf (xs n)‖ := one_mul _
      _ ≤ 2 * ‖xs n‖ := norm_cplxOf_le _
  -- the real parts lie in a fixed compact window
  have hbdd : ∀ n, (y n) 0 ∈ Set.Icc (-(lam + 1)) (lam + 1) := by
    intro n
    have h1 := hy1 n
    have h2 := hy2 n
    rw [Set.mem_Icc]
    constructor
    · linarith [neg_abs_le (y n 0), h2]
    · linarith [le_abs_self (y n 0), h2]
  obtain ⟨a, haI, φ, hφ, hconv⟩ := isCompact_Icc.tendsto_subseq hbdd
  have hφtop : Tendsto φ atTop atTop := hφ.tendsto_atTop
  -- the complex coordinates of the subsequence tend to zero
  have hxsφ : Tendsto (fun n => xs (φ n)) atTop (𝓝 0) := hxstend.comp hφtop
  have hnormφ : Tendsto (fun n => ‖xs (φ n)‖) atTop (𝓝 0) := by
    simpa using hxsφ.norm
  have hcplxφ : Tendsto (fun n => cplxOf (y (φ n))) atTop (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    refine squeeze_zero (fun n => norm_nonneg _) (fun n => hyC (φ n)) ?_
    have h2 : Tendsto (fun n => 2 * ‖xs (φ n)‖) atTop (𝓝 (2 * 0)) :=
      tendsto_const_nhds.mul hnormφ
    simpa using h2
  -- hence the subsequence converges to the axis point
  have hpt : Tendsto (fun n => y (φ n)) atTop (𝓝 (a • BerendModulus.e (0 : Fin 3))) := by
    rw [tendsto_pi_nhds]
    intro j
    fin_cases j
    · have h2 : Tendsto (fun n => y (φ n) 0) atTop (𝓝 a) := hconv
      simpa [BerendModulus.e] using h2
    · have h := (Complex.continuous_re.tendsto (0 : ℂ)).comp hcplxφ
      have h2 : Tendsto (fun n => y (φ n) 1) atTop (𝓝 0) := h
      simpa [BerendModulus.e] using h2
    · have h := (Complex.continuous_im.tendsto (0 : ℂ)).comp hcplxφ
      have h2 : Tendsto (fun n => y (φ n) 2) atTop (𝓝 0) := h
      simpa [BerendModulus.e] using h2
  have hmemE : a • BerendModulus.e (0 : Fin 3) ∈ E :=
    hE.mem_of_tendsto hpt (Eventually.of_forall fun n => hyE (φ n))
  have hage : 1 ≤ |a| := by
    have h3 : Tendsto (fun n => |(y (φ n)) 0|) atTop (𝓝 |a|) := by
      have h2 : Tendsto (fun n => (y (φ n)) 0) atTop (𝓝 a) := hconv
      simpa [BerendModulus.e] using h2.abs
    exact ge_of_tendsto h3 (Eventually.of_forall fun n => hy1 (φ n))
  exact ⟨a, (abs_pos.mp (lt_of_lt_of_le zero_lt_one hage)), hmemE⟩

/-! ## 6. Stage I, non-planar accumulation -/

/-- **Stage I for the block model, non-planar accumulation.**  If `Y` is closed and
family-invariant and the lift accumulates at `0` along points with nonzero real
coordinate, then `Y` is the whole torus.

Thus the only remaining case of Stage I is accumulation along the invariant
complex plane, which is exactly the residual isolated in
`BerendBlockLastMile.zeroNonisolatedFull_iff_unboundedPlane`. -/
theorem eq_univ_of_nonplanar_acc (D : UnitPrimeModel L 𝒪) (ε : 𝒪ˣ)
    (hε1 : 1 < |D.unit_image ε 0|)
    (hεN : |normR (D.unit_image ε)| = 1)
    {Y : Set (Torus L)} (hY : IsClosed Y) (hinv : ∀ i, D.torusAct i '' Y ⊆ Y)
    (hscal : Dense (Set.range fun i : 𝒪ˣ × ℕ => (D.mult i.1 i.2) 0))
    (haxis : Dense ((BerendSec4.coord ({0} : Set (Fin 3)) : Set Pt) + (L : Set Pt)))
    (hacc : (0 : Pt) ∈ closure ((QuotientAddGroup.mk' L) ⁻¹' Y ∩ {x | x 0 ≠ 0})) :
    Y = univ := by
  have hE : IsClosed ((QuotientAddGroup.mk' L) ⁻¹' Y) :=
    hY.preimage continuous_quotient_mk'
  have hinvE : ∀ i x, x ∈ (QuotientAddGroup.mk' L) ⁻¹' Y →
      D.family.act i x ∈ (QuotientAddGroup.mk' L) ⁻¹' Y :=
    fun i x hx => preimage_invariant D hinv i hx
  obtain ⟨a, ha, hpt⟩ := exists_axis_point_of_acc D ε hε1 hεN hE hinvE hacc
  exact eq_univ_of_axis_point D hY hinv ha hpt hscal haxis

/-! ## 7. Splitting an accumulation at `0` into the planar and non-planar parts -/

/-- A sequence converging to a point with limit `x` splits into its points off the
complex plane and its points on it: `x` is an accumulation point of one of the two
pieces. -/
lemma closure_inter_axis_dichotomy {S : Set Pt} {x : Pt} (h : x ∈ closure S) :
    x ∈ closure (S ∩ {y : Pt | y 0 ≠ 0}) ∨ x ∈ closure (S ∩ {y : Pt | y 0 = 0}) := by
  by_contra hcon
  rw [not_or] at hcon
  obtain ⟨h1, h2⟩ := hcon
  rw [mem_closure_iff] at h h1 h2
  push_neg at h1 h2
  obtain ⟨u1, hu1o, hxu1, hu1⟩ := h1
  obtain ⟨u2, hu2o, hxu2, hu2⟩ := h2
  obtain ⟨y, hy, hyS⟩ := h (u1 ∩ u2) (hu1o.inter hu2o) ⟨hxu1, hxu2⟩
  have hmem : y ∈ u1 ∩ (S ∩ {y : Pt | y 0 ≠ 0}) := by
    refine ⟨hy.1, hyS, ?_⟩
    intro h0
    have hmem2 : y ∈ u2 ∩ (S ∩ {y : Pt | y 0 = 0}) := ⟨hy.2, hyS, h0⟩
    rw [hu2] at hmem2
    exact hmem2
  rw [hu1] at hmem
  exact hmem

/-! ## 8. Stage I reduces exactly to the planar case -/

/-- **Stage I is the planar-accumulation case.**  Granting the two arithmetic
inputs (`{μ 0}` dense in `ℝ`, `coord {0} + L` dense) and the planar residual — a
closed invariant `Y` whose lift accumulates at `0` inside the complex plane is
everything — Stage I holds for the unit–prime family.

So the deep obligation left by this file is *only* accumulation along the complex
plane `{x | x 0 = 0}`; everything reached from off that plane is settled by
`eq_univ_of_nonplanar_acc`. -/
theorem zeroNonisolatedFull_of_planar_acc (D : UnitPrimeModel L 𝒪) (ε : 𝒪ˣ)
    (hε1 : 1 < |D.unit_image ε 0|)
    (hεN : |normR (D.unit_image ε)| = 1)
    (hscal : Dense (Set.range fun i : 𝒪ˣ × ℕ => (D.mult i.1 i.2) 0))
    (haxis : Dense ((BerendSec4.coord ({0} : Set (Fin 3)) : Set Pt) + (L : Set Pt)))
    (hplanar : ∀ Y : Set (Torus L), IsClosed Y →
      (∀ i, D.torusAct i '' Y ⊆ Y) →
      (0 : Pt) ∈ closure ((QuotientAddGroup.mk' L) ⁻¹' (Y \ {0}) ∩ {x | x 0 = 0}) →
      Y = univ) :
    BerendDichotomy.ZeroNonisolatedFull D.torusAct := by
  intro Y hY _hne hacc hinv
  have hopen : IsOpenMap (QuotientAddGroup.mk' L : Pt → Torus L) :=
    QuotientAddGroup.isOpenQuotientMap_mk.isOpenMap
  have hcont : Continuous (QuotientAddGroup.mk' L : Pt → Torus L) :=
    QuotientAddGroup.isOpenQuotientMap_mk.continuous
  have hlift : (0 : Pt) ∈ closure ((QuotientAddGroup.mk' L) ⁻¹' (Y \ {0})) := by
    rw [← IsOpenMap.preimage_closure_eq_closure_preimage hopen hcont]
    simpa using hacc
  rcases closure_inter_axis_dichotomy hlift with hoff | hon
  · have hsub : (QuotientAddGroup.mk' L) ⁻¹' (Y \ {0}) ∩ {x : Pt | x 0 ≠ 0}
        ⊆ (QuotientAddGroup.mk' L) ⁻¹' Y ∩ {x : Pt | x 0 ≠ 0} :=
      fun x hx => ⟨Set.preimage_mono Set.sdiff_subset hx.1, hx.2⟩
    exact eq_univ_of_nonplanar_acc D ε hε1 hεN hY hinv hscal haxis (closure_mono hsub hoff)
  · exact hplanar Y hY hinv hon

/-! ## 9. Field-model form: the locking hypothesis is `|Nm (sigma eps)| = 1` -/

/-- **Stage I, planar reduction, at the `FieldModel` level.**  The norm hypothesis
`|normR (D.unit_image ε)| = 1` of
`zeroNonisolatedFull_of_planar_acc` is derived from
`FieldModel.abs_normR_unit`; only the direction `1 < |σ(ε) 0|` (choose `ε` or
`ε⁻¹` from a non-critical unit) and the two arithmetic densities are carried. -/
theorem zeroNonisolatedFull_fieldModel_of_planar (FM : FieldModel K 𝒪 Nm) (ε : 𝒪ˣ)
    (π : K) (hπO : π ∈ 𝒪) (hπ0 : π ≠ 0)
    (hε1 : 1 < |FM.σ (((ε : 𝒪) : K)) 0|)
    (hscal : Dense (Set.range fun i : 𝒪ˣ × ℕ =>
      ((FM.toModel ε π hπO hπ0).mult i.1 i.2) 0))
    (haxis : Dense ((BerendSec4.coord ({0} : Set (Fin 3)) : Set Pt) + (FM.lattice : Set Pt)))
    (hplanar : ∀ Y : Set (Torus FM.lattice), IsClosed Y →
      (∀ i, (FM.toModel ε π hπO hπ0).torusAct i '' Y ⊆ Y) →
      (0 : Pt) ∈ closure ((QuotientAddGroup.mk' FM.lattice) ⁻¹' (Y \ {0}) ∩
        {x | x 0 = 0}) → Y = univ) :
    BerendDichotomy.ZeroNonisolatedFull (FM.toModel ε π hπO hπ0).torusAct :=
  zeroNonisolatedFull_of_planar_acc (FM.toModel ε π hπO hπ0) ε hε1
    (FM.abs_normR_unit ε) hscal haxis hplanar

end BerendStageIBlock
end CubicTwoStage

