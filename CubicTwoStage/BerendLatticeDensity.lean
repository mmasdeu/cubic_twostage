/-
# Lattice characters and characterwise density on the project torus

This module transports the generic character-approximation criterion to the
project's `Torus L`, using the integral functionals from the canonical B1
bridge.  A real dual basis of a full lattice supplies separating characters;
Stone--Weierstrass then gives density of their complex linear span.
-/
import CubicTwoStage.BerendProp43Bridge
import CubicTwoStage.BerendTorusCharacters
import Mathlib.MeasureTheory.Constructions.Polish.Basic

noncomputable section

open Set Filter Topology MeasureTheory Module BerendTorusCharacters
open scoped ComplexConjugate ENNReal Pointwise BigOperators

namespace CubicTwoStage
namespace BerendProp43Canonical
namespace BerendLatticeDensity

variable {L : AddSubgroup Pt}

lemma continuous_characterOf (χ : latticeCharacters L) : Continuous (characterOf χ) := by
  apply (QuotientAddGroup.isQuotientMap_mk L).continuous_iff.mpr
  exact QuotientAddGroup.continuous_mk.comp
    (LinearMap.continuous_of_finiteDimensional χ.1)

/-- A lattice character as a continuous complex-valued circle character. -/
noncomputable def characterC (χ : latticeCharacters L) : C(Torus L, ℂ) where
  toFun z := AddCircle.toCircle (characterOf χ z)
  continuous_toFun := continuous_subtype_val.comp
    (AddCircle.continuous_toCircle.comp (continuous_characterOf χ))

@[simp] lemma characterC_apply (χ : latticeCharacters L) (z : Torus L) :
    characterC χ z = AddCircle.toCircle (characterOf χ z) := rfl

lemma characterOf_zero_apply (z : Torus L) :
    characterOf (0 : latticeCharacters L) z = 0 := by
  change characterHom (0 : latticeCharacters L) z = 0
  simp

lemma characterOf_add_apply (χ ψ : latticeCharacters L) (z : Torus L) :
    characterOf (χ + ψ) z = characterOf χ z + characterOf ψ z := by
  change characterHom (χ + ψ) z = characterHom χ z + characterHom ψ z
  simp

lemma characterOf_neg_apply (χ : latticeCharacters L) (z : Torus L) :
    characterOf (-χ) z = -characterOf χ z := by
  change characterHom (-χ) z = -characterHom χ z
  simp

@[simp] lemma characterC_zero (z : Torus L) :
    characterC (0 : latticeCharacters L) z = 1 := by
  simp [characterC_apply, characterOf_zero_apply]

lemma characterC_add (χ ψ : latticeCharacters L) (z : Torus L) :
    characterC (χ + ψ) z = characterC χ z * characterC ψ z := by
  simp [characterC_apply, characterOf_add_apply, AddCircle.toCircle_add]

lemma characterC_neg (χ : latticeCharacters L) (z : Torus L) :
    characterC (-χ) z = (characterC χ z)⁻¹ := by
  simp only [characterC_apply, characterOf_neg_apply]
  rw [AddCircle.toCircle_neg]
  rfl

/-- The star algebra generated by the lattice characters. -/
noncomputable def characterSubalgebra (L : AddSubgroup Pt) :
    StarSubalgebra ℂ C(Torus L, ℂ) where
  toSubalgebra := Algebra.adjoin ℂ (Set.range characterC)
  star_mem' := by
    change Algebra.adjoin ℂ (Set.range (characterC (L := L))) ≤
      star (Algebra.adjoin ℂ (Set.range (characterC (L := L))))
    refine Algebra.adjoin_le ?_
    rintro _ ⟨χ, rfl⟩
    refine Algebra.subset_adjoin ⟨-χ, ?_⟩
    ext z
    simp only [ContinuousMap.star_apply, RCLike.star_def, characterC_neg]
    exact Circle.coe_inv_eq_conj _

/-- The generated algebra is already the complex linear span of characters. -/
theorem characterSubalgebra_coe :
    (characterSubalgebra L).toSubalgebra.toSubmodule =
      Submodule.span ℂ (Set.range (characterC (L := L))) := by
  apply Algebra.adjoin_eq_span_of_subset
  refine .trans (fun x => Submonoid.closure_induction (fun _ => id) ⟨0, ?_⟩ ?_) Submodule.subset_span
  · ext z
    exact characterC_zero z
  · rintro _ _ _ _ ⟨χ, rfl⟩ ⟨ψ, rfl⟩
    refine ⟨χ + ψ, ?_⟩
    ext z
    exact characterC_add χ ψ z

section BasisCharacters

variable [DiscreteTopology (AddSubgroup.toIntSubmodule L)]
  [IsZLattice ℝ (AddSubgroup.toIntSubmodule L)]
variable {ι : Type*} [Fintype ι] (b : Basis ι ℤ (AddSubgroup.toIntSubmodule L))

local notation "B" => b.ofZLatticeBasis ℝ (AddSubgroup.toIntSubmodule L)

/-- A real-dual-basis coordinate is an integral functional on the lattice. -/
noncomputable def coordCharacter (i : ι) : latticeCharacters L where
  val := (B).coord i
  property := by
    intro x hx
    let x' : AddSubgroup.toIntSubmodule L := ⟨x, hx⟩
    refine ⟨(b.repr x' i : ℤ), ?_⟩
    change ((B).repr x) i = ((b.repr x' i : ℤ) : ℝ)
    exact Module.Basis.ofZLatticeBasis_repr_apply ℝ (AddSubgroup.toIntSubmodule L) b x' i

@[simp] lemma coordCharacter_apply (i : ι) (x : Pt) :
    (coordCharacter b i).1 x = ((B).repr x) i := rfl

/-- If every real-dual coordinate is integral, the point belongs to the
original integer lattice. -/
lemma mem_lattice_of_forall_coord_int {z : Pt}
    (hz : ∀ i, ∃ m : ℤ, ((B).repr z) i = m) : z ∈ L := by
  classical
  have hz' : z ∈ Submodule.span ℤ (Set.range ((B) : ι → Pt)) := by
    have heq : z = ∑ i, ((B).repr z) i • B i := ((B).sum_repr z).symm
    rw [heq]
    apply Submodule.sum_mem
    intro i _hi
    obtain ⟨m, hm⟩ := hz i
    rw [hm, Int.cast_smul_eq_zsmul]
    have hbi : B i ∈ Submodule.span ℤ (Set.range ((B) : ι → Pt)) :=
      Submodule.subset_span ⟨i, rfl⟩
    exact zsmul_mem hbi m
  have hspan := Module.Basis.ofZLatticeBasis_span ℝ (AddSubgroup.toIntSubmodule L) b
  have hz'' : z ∈ AddSubgroup.toIntSubmodule L := by
    rw [← hspan]
    exact hz'
  exact hz''

/-- A non-lattice point has a dual-coordinate character which is not
integral at that point. -/
lemma exists_coordCharacter_not_int {z : Pt} (hz : z ∉ L) :
    ∃ i : ι, ¬ ∃ m : ℤ, (coordCharacter b i).1 z = m := by
  by_contra h
  push_neg at h
  exact hz (mem_lattice_of_forall_coord_int b h)

include b

/-- Lattice characters separate points of the quotient torus. -/
theorem characterSubalgebra_separatesPoints [CompactSpace (Torus L)] :
    (characterSubalgebra L).SeparatesPoints := by
  classical
  intro x y hxy
  obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective L x
  obtain ⟨y, rfl⟩ := QuotientAddGroup.mk'_surjective L y
  have hz : x - y ∉ L := by
    intro hmem
    exact hxy (QuotientAddGroup.eq_iff_sub_mem.mpr hmem)
  obtain ⟨i, hi⟩ := exists_coordCharacter_not_int b hz
  let χ : latticeCharacters L := coordCharacter b i
  refine ⟨_, ⟨characterC χ, Algebra.subset_adjoin ⟨χ, rfl⟩, rfl⟩, ?_⟩
  intro heq
  have hcCircle : (characterOf χ ((QuotientAddGroup.mk' L) x)).toCircle =
      (characterOf χ ((QuotientAddGroup.mk' L) y)).toCircle := Circle.ext heq
  have hc := AddCircle.injective_toCircle (one_ne_zero : (1 : ℝ) ≠ 0) hcCircle
  rw [characterOf_mk', characterOf_mk'] at hc
  have hmem : χ.1 x - χ.1 y ∈ AddSubgroup.zmultiples (1 : ℝ) :=
    QuotientAddGroup.eq_iff_sub_mem.mp hc
  obtain ⟨m, hm⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
  apply hi
  refine ⟨m, ?_⟩
  change χ.1 (x - y) = (m : ℝ)
  rw [map_sub, ← hm, Int.smul_one_eq_cast]

/-- Stone--Weierstrass for the lattice-character algebra. -/
theorem characterSubalgebra_closure_eq_top [CompactSpace (Torus L)] :
    (characterSubalgebra L).topologicalClosure = ⊤ :=
  ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints _
    (characterSubalgebra_separatesPoints b)

/-- The complex linear span of lattice characters is uniformly dense. -/
theorem span_characterC_closure_eq_top [CompactSpace (Torus L)] :
    (Submodule.span ℂ (Set.range (characterC (L := L)))).topologicalClosure = ⊤ := by
  rw [← characterSubalgebra_coe]
  exact congrArg (Subalgebra.toSubmodule <| StarSubalgebra.toSubalgebra ·)
    (characterSubalgebra_closure_eq_top b)

end BasisCharacters

section ProjectNet

variable {L : AddSubgroup Pt} [CompactSpace (Torus L)]
  [IsClosed (L : Set Pt)] [SecondCountableTopology (Torus L)]

lemma characterC_add_point (χ : latticeCharacters L) (x y : Torus L) :
    characterC χ (x + y) = characterC χ x * characterC χ y := by
  simp [characterC_apply, AddCircle.toCircle_add]

lemma characterC_eq_one_iff (χ : latticeCharacters L) (z : Torus L) :
    characterC χ z = 1 ↔ characterOf χ z = 0 := by
  constructor
  · intro hz
    have hc : (characterOf χ z).toCircle = 1 := Circle.coe_eq_one.mp hz
    apply AddCircle.injective_toCircle (one_ne_zero : (1 : ℝ) ≠ 0)
    simpa using hc
  · intro hz
    simp [characterC_apply, hz]

/-- Pushforward of normalized Haar measure on a compact subgroup of the
project torus. -/
noncomputable def quotientSubgroupMeasure (H : AddSubgroup (Torus L))
    [CompactSpace H] : Measure (Torus L) :=
  Measure.map ((↑) : H → Torus L) (compactHaar H)

noncomputable instance quotientSubgroupMeasure_isProbability
    (H : AddSubgroup (Torus L)) [CompactSpace H] :
    IsProbabilityMeasure (quotientSubgroupMeasure H) :=
  Measure.isProbabilityMeasure_map continuous_subtype_val.measurable.aemeasurable

lemma quotientSubgroupMeasure_compl (H : AddSubgroup (Torus L)) [CompactSpace H]
    (hH : IsClosed (H : Set (Torus L))) :
    quotientSubgroupMeasure H ((H : Set (Torus L))ᶜ) = 0 := by
  rw [quotientSubgroupMeasure, Measure.map_apply continuous_subtype_val.measurable
    hH.measurableSet.compl]
  have hempty : ((↑) : H → Torus L) ⁻¹' (H : Set (Torus L))ᶜ = ∅ := by
    ext h
    simp
  rw [hempty, measure_empty]

lemma integral_characterC_quotientSubgroupMeasure {H : AddSubgroup (Torus L)}
    [CompactSpace H] (χ : latticeCharacters L)
    (hχ : ∃ h ∈ H, characterOf χ h ≠ 0) :
    ∫ z, characterC χ z ∂quotientSubgroupMeasure H = 0 := by
  obtain ⟨h, hh, hne⟩ := hχ
  rw [quotientSubgroupMeasure, integral_map continuous_subtype_val.measurable.aemeasurable
    (characterC χ).continuous.aestronglyMeasurable]
  apply integral_eq_zero_of_add_character_ne_one (g := (⟨h, hh⟩ : H))
    (compactHaar H) (fun h : H => characterC χ (h : Torus L))
  · intro x y
    exact characterC_add_point χ (x : Torus L) (y : Torus L)
  · exact (characterC_eq_one_iff χ h).not.mpr hne

/-- A lattice character which vanishes identically is zero. -/
lemma characterOf_eq_zero_of_forall (χ : latticeCharacters L)
    (hχ : ∀ z, characterOf χ z = 0) : χ = 0 := by
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  have hint : ∀ w : Pt, ∃ m : ℤ, χ.1 w = m := by
    intro w
    have hz := hχ ((QuotientAddGroup.mk' L) w)
    rw [characterOf_mk'] at hz
    have hmem := (QuotientAddGroup.eq_zero_iff (χ.1 w)).mp hz
    obtain ⟨m, hm⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
    exact ⟨m, by rw [← hm, Int.smul_one_eq_cast]⟩
  obtain ⟨m, hm⟩ := hint x
  by_cases hm0 : m = 0
  · rw [hm0] at hm
    simpa using hm
  obtain ⟨n, hn⟩ := hint (((2 * (m : ℝ))⁻¹) • x)
  have hval : χ.1 (((2 * (m : ℝ))⁻¹) • x) = (1 / 2 : ℝ) := by
    rw [map_smul, smul_eq_mul, hm]
    field_simp
  rw [hval] at hn
  have hn' : 2 * n = 1 := by
    have hreal : (2 : ℝ) * (n : ℝ) = 1 := by linarith
    exact_mod_cast hreal
  omega

lemma exists_characterOf_ne_zero {χ : latticeCharacters L} (hχ : χ ≠ 0) :
    ∃ z, characterOf χ z ≠ 0 := by
  by_contra h
  push_neg at h
  exact hχ (characterOf_eq_zero_of_forall χ h)

lemma integral_characterC_compactHaar_eq_zero {χ : latticeCharacters L} (hχ : χ ≠ 0) :
    ∫ z, characterC χ z ∂compactHaar (Torus L) = 0 := by
  obtain ⟨z, hz⟩ := exists_characterOf_ne_zero hχ
  apply integral_eq_zero_of_add_character_ne_one (g := z)
    (compactHaar (Torus L)) (characterC χ)
  · exact characterC_add_point χ
  · exact (characterC_eq_one_iff χ z).not.mpr hz

/-- **Proposition-4.3 net criterion on the project torus.**  If every nonzero
integral character is nontrivial on the closed subgroup `G n` eventually, then
arbitrarily fine nets occur among these subgroups. -/
theorem exists_net_of_latticeCharacter_nontrivial_eventually
    [DiscreteTopology (AddSubgroup.toIntSubmodule L)]
    [IsZLattice ℝ (AddSubgroup.toIntSubmodule L)]
    {ι : Type*} [Fintype ι] (b : Basis ι ℤ (AddSubgroup.toIntSubmodule L))
    (G : ℕ → AddSubgroup (Torus L)) [∀ n, CompactSpace (G n)]
    (hG : ∀ n, IsClosed (G n : Set (Torus L)))
    (hchar : ∀ χ : latticeCharacters L, χ ≠ 0 → ∀ᶠ n in atTop,
      ∃ h ∈ G n, characterOf χ h ≠ 0)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ n : ℕ, ∀ x : Torus L, ∃ y ∈ G n, dist x y < ε := by
  refine exists_net_generic (compactHaar (Torus L))
    (fun n => quotientSubgroupMeasure (G n)) (characterC (L := L))
    (span_characterC_closure_eq_top b) ?_ G ?_ hε
  · intro χ
    by_cases hχ : χ = 0
    · subst χ
      filter_upwards [] with n
      simp [characterC_zero, characterOf_zero_apply]
    · filter_upwards [hchar χ hχ] with n hn
      rw [integral_characterC_quotientSubgroupMeasure χ hn,
        integral_characterC_compactHaar_eq_zero hχ]
  · intro n
    exact quotientSubgroupMeasure_compl (G n) (hG n)

end ProjectNet

